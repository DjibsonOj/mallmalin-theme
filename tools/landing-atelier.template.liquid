{%- comment -%}
  Design « Atelier » — landing produit épurée premium (fond blanc, typo serif élégante,
  accent sobre). Fichier GÉNÉRÉ par tools/build.py à partir de tools/products/<produit>.json :
  ne pas éditer layout/landing-*.liquid à la main.
  ► Pixel : AUCUN pixel ici. {{ content_for_header }} charge celui de la boutique.
  ► Formulaire COD : rendu par la section mm-cod ({{ content_for_layout }}) dans le panneau #commander.
{%- endcomment -%}
{%- assign mm_new = '[[price_new]]' -%}
{%- assign mm_old = '[[price_old]]' -%}
{%- assign mm_cur = '[[currency]]' -%}
{%- assign mm_new_num = '[[price_new_num]]' -%}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>[[seo_title]]</title>
  <meta name="description" content="[[seo_description]]">
  <meta name="theme-color" content="#fbfaf7">
  <link rel="canonical" href="{{ canonical_url }}">
  <meta property="og:type" content="product">
  <meta property="og:title" content="[[og_title]]">
  <meta property="og:description" content="[[og_description]]">
  <meta property="og:image" content="https:{{ '[[img]][[hero_image]]' | asset_url }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:locale" content="fr_FR">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="{{ '[[logo_file]]' | asset_url }}">
  <link rel="preload" as="image" href="{{ '[[img]][[hero_image]]' | asset_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "[[ld_name]]",
    "description": "[[ld_description]]",
    "image": "https:{{ '[[img]][[hero_image]]' | asset_url }}",
    "brand": { "@type": "Brand", "name": "[[brand]]" },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "[[currency_iso]]",
      "price": "{{ mm_new_num }}",
      "availability": "https://schema.org/InStock",
      "url": "{{ canonical_url }}"
    }
  }
  </script>
  {{ content_for_header }}
  <style>
/* ═══════════════════════════════════════════════
   DESIGN « ATELIER » — tokens
   Seules les couleurs --accent / --accent-soft changent d'une
   boutique à l'autre (champ "accent" du fichier produit).
   ═══════════════════════════════════════════════ */
:root{
  --paper:#fbfaf7;        /* fond de page */
  --panel:#f3f1ec;        /* fonds des visuels / encarts */
  --line:#e6e2da;         /* filets */
  --ink:#1d1c1a;          /* texte + bouton principal */
  --muted:#6f6b63;        /* texte secondaire */
  --accent:[[accent]];    /* accent sobre : badges, petits titres */
  --accent-soft:color-mix(in srgb, var(--accent) 12%, var(--paper));
  --serif:'Cormorant Garamond', Georgia, 'Times New Roman', serif;
  --sans:'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif;
  --wrap:1180px;
  --gutter:clamp(18px,4.5vw,48px);
  --r:14px;
  --ease:cubic-bezier(.22,1,.36,1);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{display:block;max-width:100%;height:auto}
a{color:inherit;text-decoration:none}
ul{list-style:none}
button{font:inherit;color:inherit}
.wrap{width:100%;max-width:var(--wrap);margin:0 auto;padding:0 var(--gutter)}
.kicker{font-size:11.5px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--accent)}
.serif{font-family:var(--serif);font-weight:500;letter-spacing:-.01em;line-height:1.08}
.serif em{font-style:italic;color:var(--accent)}
.h2{font-size:clamp(34px,4.6vw,54px);margin:12px 0 0}
.lead{color:var(--muted);font-size:clamp(16px,1.4vw,18px);max-width:560px}
.sec{padding:clamp(64px,9vw,120px) 0}
.sec-head{display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px;margin-bottom:clamp(36px,5vw,64px)}
.sec-head .lead{margin:0 auto}

/* ── boutons ── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:54px;padding:0 30px;border-radius:999px;font-size:15px;font-weight:600;letter-spacing:.01em;cursor:pointer;border:1px solid var(--ink);transition:background .25s,color .25s,transform .25s var(--ease)}
.btn-ink{background:var(--ink);color:#fff}
.btn-ink:hover{background:#000;transform:translateY(-1px)}
.btn-line{background:transparent;color:var(--ink)}
.btn-line:hover{background:var(--ink);color:#fff}
.btn svg{width:16px;height:16px}

/* ── bandeau + en-tête ── */
.announce{background:var(--ink);color:#f1efe9;font-size:12px;letter-spacing:.08em;text-align:center;padding:9px 16px}
.head{position:sticky;top:0;z-index:50;background:rgba(251,250,247,.9);backdrop-filter:saturate(1.4) blur(12px);-webkit-backdrop-filter:saturate(1.4) blur(12px);border-bottom:1px solid transparent;transition:border-color .3s}
.head.is-stuck{border-bottom-color:var(--line)}
.head .wrap{display:flex;align-items:center;justify-content:space-between;height:66px;gap:16px}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--serif);font-size:25px;font-weight:600;letter-spacing:.01em}
.brand img{width:32px;height:32px;border-radius:50%;object-fit:cover}
.head-nav{display:flex;gap:28px;font-size:14px;color:var(--muted)}
.head-nav a:hover{color:var(--ink)}
.head-cta{display:flex;align-items:center;gap:14px}
.head-price{font-size:14px;font-weight:600;white-space:nowrap}
.head .btn{min-height:42px;padding:0 20px;font-size:14px}

/* ── hero ── */
.hero{padding:clamp(28px,5vw,64px) 0 clamp(48px,7vw,96px)}
.hero .wrap{display:grid;grid-template-columns:1.02fr 1fr;gap:clamp(28px,5vw,72px);align-items:center}
.hero-copy{display:flex;flex-direction:column;gap:22px}
.hero h1{font-size:clamp(44px,6.4vw,84px);line-height:1.02}
.hero-sub{color:var(--muted);font-size:clamp(16px,1.5vw,19px);max-width:500px}
.price-row{display:flex;align-items:baseline;flex-wrap:wrap;gap:6px 14px}
.price-new{font-family:var(--serif);font-size:clamp(34px,3.6vw,44px);font-weight:600;line-height:1}
.price-new small{font-family:var(--sans);font-size:14px;font-weight:600;margin-left:4px;letter-spacing:.04em}
.price-old{color:var(--muted);text-decoration:line-through;font-size:16px}
.badge{display:inline-block;background:var(--accent-soft);color:var(--accent);font-size:12px;font-weight:600;letter-spacing:.06em;padding:5px 11px;border-radius:999px}
.hero-actions{display:flex;flex-wrap:wrap;align-items:center;gap:14px 22px}
.hero-note{font-size:13px;color:var(--muted)}
.hero-points{display:flex;flex-direction:column;gap:9px;padding-top:6px;border-top:1px solid var(--line)}
.hero-points li{display:flex;gap:11px;align-items:flex-start;font-size:15px;padding-top:9px}
.tick{flex:none;width:20px;height:20px;border-radius:50%;background:var(--accent-soft);display:grid;place-items:center;margin-top:2px}
.tick svg{width:11px;height:11px;stroke:var(--accent)}

.gallery{display:flex;flex-direction:column;gap:12px}
.g-main{position:relative;aspect-ratio:4/5;border-radius:var(--r);overflow:hidden;background:var(--panel)}
.g-main img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .45s ease}
.g-main img.is-fading{opacity:0}
.g-tag{position:absolute;left:16px;top:16px;background:rgba(255,255,255,.92);font-size:11.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:7px 12px;border-radius:999px}
.g-thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.g-thumbs button{aspect-ratio:1;border-radius:10px;overflow:hidden;border:1px solid var(--line);background:var(--panel);cursor:pointer;padding:0;opacity:.62;transition:opacity .25s,border-color .25s}
.g-thumbs button[aria-current="true"]{opacity:1;border-color:var(--ink)}
.g-thumbs img{width:100%;height:100%;object-fit:cover}

/* ── réassurance ── */
.trust{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff}
.trust ul{display:grid;grid-template-columns:repeat(4,1fr)}
.trust li{display:flex;gap:14px;align-items:flex-start;padding:26px 22px;border-left:1px solid var(--line)}
.trust li:first-child{border-left:0}
.trust svg{flex:none;width:26px;height:26px;stroke:var(--ink);stroke-width:1.4;fill:none}
.trust b{display:block;font-size:14.5px;font-weight:600}
.trust span{display:block;font-size:13px;color:var(--muted);line-height:1.45;margin-top:2px}

/* ── manifeste ── */
.intro{text-align:center}
.intro p.serif{font-size:clamp(28px,3.8vw,46px);max-width:900px;margin:18px auto 0;line-height:1.18}

/* ── bénéfices ── */
.benefits{display:flex;flex-direction:column;gap:clamp(56px,8vw,110px)}
.benefit{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,6vw,90px);align-items:center}
.benefit:nth-child(even) .b-media{order:2}
.b-media{aspect-ratio:5/6;border-radius:var(--r);overflow:hidden;background:var(--panel)}
.b-media img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s var(--ease)}
.benefit:hover .b-media img{transform:scale(1.03)}
.b-copy{display:flex;flex-direction:column;gap:16px;max-width:470px}
.b-num{font-family:var(--serif);font-size:20px;color:var(--accent);font-style:italic}
.b-copy h3{font-size:clamp(30px,3.4vw,44px)}
.b-copy p{color:var(--muted);font-size:17px}
.b-copy .btn{align-self:flex-start;margin-top:8px}

/* ── détails / caractéristiques ── */
.details{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.details .wrap{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,6vw,90px);align-items:center}
.d-media{aspect-ratio:1;border-radius:var(--r);overflow:hidden;background:var(--panel)}
.d-media img{width:100%;height:100%;object-fit:cover}
.specs{margin-top:28px;border-top:1px solid var(--line)}
.specs li{display:flex;justify-content:space-between;gap:20px;padding:16px 0;border-bottom:1px solid var(--line);font-size:15px}
.specs li span{color:var(--muted)}
.specs li b{font-weight:600;text-align:right}

/* ── étapes ── */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.step{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:clamp(24px,3vw,36px);display:flex;flex-direction:column;gap:12px}
.step-n{width:44px;height:44px;border-radius:50%;border:1px solid var(--ink);display:grid;place-items:center;font-family:var(--serif);font-size:22px;font-weight:600}
.step h3{font-size:28px;margin-top:8px}
.step p{color:var(--muted);font-size:15.5px}

/* ── offre ── */
.offer{background:var(--panel)}
.offer-card{display:grid;grid-template-columns:1.1fr 1fr;background:#fff;border-radius:calc(var(--r) + 6px);overflow:hidden;box-shadow:0 30px 60px -40px rgba(29,28,26,.35)}
.offer-media{background:var(--panel);min-height:100%}
.offer-media img{width:100%;height:100%;object-fit:cover}
.offer-body{padding:clamp(28px,4.5vw,56px);display:flex;flex-direction:column;gap:18px}
.offer-body h2{font-size:clamp(32px,3.6vw,46px)}
.offer-body>p{color:var(--muted)}
.included li{display:flex;gap:11px;align-items:flex-start;padding:7px 0;font-size:15px}
.offer-price{display:flex;align-items:baseline;flex-wrap:wrap;gap:6px 14px;padding:18px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.offer-body .btn{width:100%}
.offer-foot{font-size:13px;color:var(--muted);text-align:center}

/* ── avis (affichés seulement s'il y en a de vrais) ── */
.reviews{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}
.review{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:28px;display:flex;flex-direction:column;gap:14px}
.review p{font-family:var(--serif);font-size:22px;line-height:1.3}
.review cite{font-style:normal;font-size:13px;color:var(--muted);letter-spacing:.04em}
.stars{color:var(--accent);letter-spacing:3px;font-size:14px}

/* ── FAQ ── */
.faq{max-width:820px;margin:0 auto;border-top:1px solid var(--line)}
.faq details{border-bottom:1px solid var(--line)}
.faq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:22px 2px;font-size:17px;font-weight:600}
.faq summary::-webkit-details-marker{display:none}
.faq summary i{flex:none;position:relative;width:14px;height:14px}
.faq summary i::before,.faq summary i::after{content:'';position:absolute;left:0;top:6px;width:14px;height:1.5px;background:var(--ink);transition:transform .3s var(--ease)}
.faq summary i::after{transform:rotate(90deg)}
.faq details[open] summary i::after{transform:rotate(0)}
.faq .a{padding:0 2px 22px;color:var(--muted);max-width:700px}

/* ── final + pied ── */
.final{text-align:center}
.final h2{font-size:clamp(40px,6vw,76px);line-height:1.04}
.final .lead{margin:18px auto 30px}
.final .price-row{justify-content:center;margin-bottom:26px}
.foot{border-top:1px solid var(--line);padding:34px 0 calc(34px + 76px)}
.foot .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:14px;font-size:13px;color:var(--muted)}
.foot .brand{font-size:21px;color:var(--ink)}

/* ── barre fixe mobile ── */
.bar{position:fixed;left:0;right:0;bottom:0;z-index:60;background:rgba(255,255,255,.96);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-top:1px solid var(--line);padding:10px var(--gutter) max(10px,env(safe-area-inset-bottom));display:flex;align-items:center;gap:14px;transform:translateY(110%);transition:transform .4s var(--ease)}
.bar.is-on{transform:none}
.bar-price{display:flex;flex-direction:column;line-height:1.15}
.bar-price b{font-size:17px}
.bar-price s{font-size:12px;color:var(--muted)}
.bar .btn{flex:1;min-height:52px;padding:0 18px;white-space:nowrap;font-size:15px}
@media (max-width:560px){.bar-price{display:none}}
@media (min-width:900px){.bar{display:none}.foot{padding-bottom:34px}}

/* ── apparition au défilement ── */
.rv{opacity:0;transform:translateY(22px);transition:opacity .9s var(--ease),transform .9s var(--ease)}
.rv.in{opacity:1;transform:none}
.no-js .rv{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}}

/* ── responsive ── */
@media (max-width:899px){
  .head-nav{display:none}
  .head .wrap{height:58px}
  .head-price{display:none}
  .hero .wrap{grid-template-columns:1fr}
  .gallery{order:-1}
  .g-main{aspect-ratio:5/4}
  .g-thumbs{gap:8px}
  .hero{padding-top:16px}
  .hero-copy{gap:18px}
  .trust ul{grid-template-columns:1fr 1fr}
  .trust li{padding:20px 14px;border-left:0;border-top:1px solid var(--line);flex-direction:column;gap:8px}
  .trust li:nth-child(-n+2){border-top:0}
  .trust li:nth-child(even){border-left:1px solid var(--line)}
  .benefit,.details .wrap,.offer-card{grid-template-columns:1fr}
  .benefit:nth-child(even) .b-media{order:0}
  .b-media{aspect-ratio:4/4.4}
  .steps{grid-template-columns:1fr}
  .offer-media{aspect-ratio:4/3}
  .hero-actions .btn{width:100%}
}
@media (max-width:420px){.brand{font-size:22px}.head .btn{padding:0 16px}}

/* ── panneau de commande (formulaire COD de l'app) ── */
html.order-open,html.order-open body{overflow:hidden}
.order-panel{position:fixed;inset:0;z-index:130;visibility:hidden;pointer-events:none;display:flex;align-items:flex-end;justify-content:center}
.order-panel.is-open{visibility:visible;pointer-events:auto}
.order-backdrop{position:absolute;inset:0;background:rgba(20,19,17,.5);opacity:0;transition:opacity .35s ease}
.order-panel.is-open .order-backdrop{opacity:1}
/* jamais de transform sur la feuille ouverte : sinon les pop-ups de l'app COD disparaissent */
.order-sheet{position:relative;z-index:1;width:min(620px,100%);max-height:92vh;max-height:92dvh;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;background:#fff;color:#1d1c1a;border-radius:20px 20px 0 0;padding:22px clamp(16px,4vw,30px) max(24px,env(safe-area-inset-bottom));outline:none;text-align:left}
.order-panel.is-open .order-sheet{animation:atSheetUp .42s cubic-bezier(.22,1,.36,1) backwards}
@keyframes atSheetUp{from{transform:translateY(60px);opacity:0}to{transform:none;opacity:1}}
@media (min-width:760px){.order-panel{align-items:center}.order-sheet{border-radius:20px;max-height:88vh}}
.order-close{position:sticky;top:0;float:right;margin:-8px -6px 0 0;width:40px;height:40px;border:0;border-radius:50%;background:var(--panel);font-size:24px;line-height:1;cursor:pointer;z-index:2}
.order-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;padding:2px 44px 16px 0;margin-bottom:12px;border-bottom:1px solid var(--line)}
.order-title{flex-basis:100%;font-family:var(--serif);font-size:26px;font-weight:600;line-height:1.15;margin-bottom:4px}
.order-old{text-decoration:line-through;color:var(--muted);font-size:14px}
.order-new{font-size:22px;font-weight:700}
.order-note{flex-basis:100%;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--accent)}
.cod-box{overflow:visible}
.cod-box *{color:inherit}
.cod-box .mm-native label{display:block;font-size:14px;margin:0 0 6px}
.cod-box .mm-native select{width:100%;font:inherit;padding:12px;border:1px solid var(--line);border-radius:10px;background:#fff;margin-bottom:14px}
.cod-box .mm-native .mm-title{font-size:17px;font-weight:600;margin-bottom:14px}
.cod-box .mm-native .btn-order{width:100%;min-height:54px;border:0;border-radius:999px;background:var(--ink);color:#fff;font-size:16px;font-weight:600;cursor:pointer}
  </style>
</head>
<body class="no-js">

  <div class="announce">[[announcement]]</div>

  <header class="head" id="head">
    <div class="wrap">
      <a class="brand" href="#top" aria-label="[[brand]]"><img src="{{ '[[logo_file]]' | asset_url }}" alt="" width="32" height="32">[[brand]]</a>
      <nav class="head-nav" aria-label="Sections">
        <a href="#avantages">Avantages</a>
        <a href="#details">Détails</a>
        <a href="#livraison">Livraison</a>
        <a href="#questions">Questions</a>
      </nav>
      <div class="head-cta">
        <span class="head-price">{{ mm_new }} {{ mm_cur }}</span>
        <a class="btn btn-ink" href="#commander" data-order>Commander</a>
      </div>
    </div>
  </header>

  <main id="top">

    <!-- ═════ HERO ═════ -->
    <section class="hero">
      <div class="wrap">
        <div class="hero-copy">
          <p class="kicker rv">[[hero_kicker]]</p>
          <h1 class="serif rv">[[hero_title_a]] <em>[[hero_title_em]]</em> [[hero_title_b]]</h1>
          <p class="hero-sub rv">[[hero_sub]]</p>
          <div class="price-row rv">
            <span class="price-new">{{ mm_new }}<small>{{ mm_cur }}</small></span>
            <span class="price-old">{{ mm_old }} {{ mm_cur }}</span>
            <span class="badge">−[[save_pct]] %</span>
          </div>
          <div class="hero-actions rv">
            <a class="btn btn-ink" href="#commander" data-order id="heroOrder">Commander maintenant<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
            <span class="hero-note">Paiement à la livraison · aucune carte bancaire</span>
          </div>
          <ul class="hero-points rv">
[[hero_points_html]]
          </ul>
        </div>
        <div class="gallery rv">
          <div class="g-main">
            <img id="gMain" src="{{ '[[img]][[hero_image]]' | asset_url }}" alt="[[hero_alt]]" width="1000" height="1250" fetchpriority="high">
            <span class="g-tag">[[hero_tag]]</span>
          </div>
          <div class="g-thumbs" role="group" aria-label="Photos du produit">
[[thumbs_html]]
          </div>
        </div>
      </div>
    </section>

    <!-- ═════ RÉASSURANCE ═════ -->
    <section class="trust" aria-label="Nos garanties">
      <div class="wrap">
        <ul>
[[trust_html]]
        </ul>
      </div>
    </section>

    <!-- ═════ MANIFESTE ═════ -->
    <section class="sec intro">
      <div class="wrap">
        <p class="kicker rv">[[intro_kicker]]</p>
        <p class="serif rv">[[intro_text]]</p>
      </div>
    </section>

    <!-- ═════ AVANTAGES ═════ -->
    <section class="sec" id="avantages" style="padding-top:0">
      <div class="wrap benefits">
[[benefits_html]]
      </div>
    </section>

    <!-- ═════ DÉTAILS ═════ -->
    <section class="sec details" id="details">
      <div class="wrap">
        <div class="d-media rv"><img src="{{ '[[img]][[details_image]]' | asset_url }}" alt="[[details_alt]]" loading="lazy"></div>
        <div class="rv">
          <p class="kicker">[[details_kicker]]</p>
          <h2 class="serif h2">[[details_title]]</h2>
          <ul class="specs">
[[specs_html]]
          </ul>
        </div>
      </div>
    </section>

    <!-- ═════ ÉTAPES ═════ -->
    <section class="sec" id="livraison">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="kicker">[[steps_kicker]]</p>
          <h2 class="serif h2">[[steps_title]]</h2>
        </div>
        <div class="steps">
[[steps_html]]
        </div>
      </div>
    </section>

    <!-- ═════ OFFRE ═════ -->
    <section class="sec offer" id="offre">
      <div class="wrap">
        <div class="offer-card rv">
          <div class="offer-media"><img src="{{ '[[img]][[offer_image]]' | asset_url }}" alt="[[offer_alt]]" loading="lazy"></div>
          <div class="offer-body">
            <p class="kicker">[[offer_kicker]]</p>
            <h2 class="serif">[[offer_title]]</h2>
            <p>[[offer_text]]</p>
            <ul class="included">
[[included_html]]
            </ul>
            <div class="offer-price">
              <span class="price-new">{{ mm_new }}<small>{{ mm_cur }}</small></span>
              <span class="price-old">{{ mm_old }} {{ mm_cur }}</span>
              <span class="badge">Vous économisez [[save_pct]] %</span>
            </div>
            <a class="btn btn-ink" href="#commander" data-order>Commander — payer à la livraison</a>
            <p class="offer-foot">[[offer_foot]]</p>
          </div>
        </div>
      </div>
    </section>

[[reviews_section]]

    <!-- ═════ FAQ ═════ -->
    <section class="sec" id="questions">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="kicker">Questions fréquentes</p>
          <h2 class="serif h2">[[faq_title]]</h2>
        </div>
        <div class="faq rv">
[[faq_html]]
        </div>
      </div>
    </section>

    <!-- ═════ FINAL ═════ -->
    <section class="sec final" style="padding-top:clamp(24px,4vw,48px)">
      <div class="wrap">
        <h2 class="serif rv">[[final_title_a]] <em>[[final_title_em]]</em></h2>
        <p class="lead rv">[[final_text]]</p>
        <div class="price-row rv">
          <span class="price-new">{{ mm_new }}<small>{{ mm_cur }}</small></span>
          <span class="price-old">{{ mm_old }} {{ mm_cur }}</span>
        </div>
        <a class="btn btn-ink rv" href="#commander" data-order id="finalOrder">Commander maintenant</a>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <span class="brand">[[brand]]</span>
      <span>[[footer_note]]</span>
      <span>© {{ 'now' | date: '%Y' }} [[brand]]</span>
    </div>
  </footer>

  <!-- ═════ BARRE FIXE MOBILE ═════ -->
  <div class="bar" id="bar">
    <div class="bar-price"><b>{{ mm_new }} {{ mm_cur }}</b><s>{{ mm_old }} {{ mm_cur }}</s></div>
    <a class="btn btn-ink" href="#commander" data-order>Acheter maintenant · {{ mm_new }} {{ mm_cur }}</a>
  </div>

  <!-- ═════ PANNEAU DE COMMANDE (formulaire COD) ═════ -->
  <div class="order-panel" id="orderPanel" aria-hidden="true">
    <div class="order-backdrop" data-close></div>
    <div class="order-sheet" id="commander" role="dialog" aria-modal="true" aria-label="Commander : [[ld_name]]" tabindex="-1">
      <button type="button" class="order-close" data-close aria-label="Fermer">&times;</button>
      <div class="order-head">
        <span class="order-title">[[ld_name]]</span>
        <span class="order-new">{{ mm_new }} {{ mm_cur }}</span>
        <span class="order-old">{{ mm_old }} {{ mm_cur }}</span>
        <span class="order-note">Paiement à la livraison — nous vous appelons pour confirmer</span>
      </div>
      <div class="cod-box">
        {{ content_for_layout }}
      </div>
    </div>
  </div>

  <script>
(function(){
  var d=document, root=d.documentElement;
  d.body.classList.remove('no-js');

  /* apparition douce au défilement */
  var rv=[].slice.call(d.querySelectorAll('.rv'));
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{rootMargin:'0px 0px -8% 0px',threshold:.08});
    rv.forEach(function(el){io.observe(el);});
  } else rv.forEach(function(el){el.classList.add('in');});

  /* galerie : vignettes → grande image */
  var main=d.getElementById('gMain');
  [].forEach.call(d.querySelectorAll('.g-thumbs button'),function(b,i,all){
    b.addEventListener('click',function(){
      if(b.getAttribute('aria-current')==='true') return;
      [].forEach.call(all,function(x){x.setAttribute('aria-current','false');});
      b.setAttribute('aria-current','true');
      main.classList.add('is-fading');
      setTimeout(function(){main.src=b.getAttribute('data-src');main.alt=b.getAttribute('data-alt');main.onload=function(){main.classList.remove('is-fading');};setTimeout(function(){main.classList.remove('is-fading');},500);},220);
    });
  });

  /* en-tête : filet quand on défile */
  var head=d.getElementById('head');
  function onScroll(){head.classList.toggle('is-stuck',window.scrollY>8);}
  window.addEventListener('scroll',onScroll,{passive:true}); onScroll();

  /* panneau de commande */
  var panel=d.getElementById('orderPanel'), sheet=d.getElementById('commander'), bar=d.getElementById('bar'), last=null;
  var heroVis=true, finalVis=false;
  function updateBar(){ if(bar) bar.classList.toggle('is-on', !heroVis && !finalVis && !panel.classList.contains('is-open')); }
  function open(){
    last=d.activeElement;
    panel.classList.add('is-open'); panel.setAttribute('aria-hidden','false');
    root.classList.add('order-open'); updateBar();
    sheet.scrollTop=0; setTimeout(function(){try{sheet.focus({preventScroll:true});}catch(e){}},60);
  }
  function close(){
    panel.classList.remove('is-open'); panel.setAttribute('aria-hidden','true');
    root.classList.remove('order-open'); updateBar();
    if(last&&last.focus){try{last.focus({preventScroll:true});}catch(e){}}
  }
  if('IntersectionObserver' in window){
    var h=d.getElementById('heroOrder'), f=d.getElementById('finalOrder');
    var ob=new IntersectionObserver(function(es){es.forEach(function(e){
      if(e.target===h) heroVis=e.isIntersecting||e.boundingClientRect.top>0; else finalVis=e.isIntersecting;
    }); updateBar();},{threshold:0});
    ob.observe(h); ob.observe(f);
  } else { heroVis=false; updateBar(); }
  d.addEventListener('click',function(e){
    var t=e.target.closest&&e.target.closest('[data-order],[data-close]');
    if(!t) return;
    e.preventDefault(); e.stopPropagation();
    if(t.hasAttribute('data-close')) close(); else open();
  },true);
  d.addEventListener('keydown',function(e){ if(e.key==='Escape'&&panel.classList.contains('is-open')) close(); });
  if(location.hash==='#commander') setTimeout(open,600);
  window.mmOrder={open:open,close:close};
})();
  </script>
</body>
</html>
