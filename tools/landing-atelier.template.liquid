{%- comment -%}
  Design « Atelier » — landing produit épurée premium (fond blanc, typo serif élégante,
  accent sobre). Fichier GÉNÉRÉ par tools/build.py à partir de tools/products/<produit>.json :
  ne pas éditer layout/landing-*.liquid à la main.
  ► Pixel : AUCUN pixel ici. {{ content_for_header }} charge celui de la boutique.
  ► Formulaire COD : rendu par la section mm-cod ({{ content_for_layout }}) dans le panneau #commander.
{%- endcomment -%}
{%- assign mm_new = '[[price_new]]' -%}
{%- assign mm_old = '[[price_old]]' -%}
{%- assign mm_cur = '[[currency]]' -%}
{%- assign mm_new_num = '[[price_new_num]]' -%}
<!DOCTYPE html>
<html lang="fr" class="[[font_class]]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>[[seo_title]]</title>
  <meta name="description" content="[[seo_description]]">
  <meta name="theme-color" content="#fafaf7">
  <link rel="canonical" href="{{ canonical_url }}">
  <meta property="og:type" content="product">
  <meta property="og:title" content="[[og_title]]">
  <meta property="og:description" content="[[og_description]]">
  <meta property="og:image" content="https:{{ '[[img]][[hero_image]]' | asset_url }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:locale" content="fr_FR">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="{{ '[[logo_file]]' | asset_url }}">
  <link rel="preload" as="image" href="{{ '[[img]][[hero_image]]' | asset_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800[[font_extra]]&display=swap" rel="stylesheet">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "[[ld_name]]",
    "description": "[[ld_description]]",
    "image": "https:{{ '[[img]][[hero_image]]' | asset_url }}",
    "brand": { "@type": "Brand", "name": "[[brand]]" },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "[[currency_iso]]",
      "price": "{{ mm_new_num }}",
      "availability": "https://schema.org/InStock",
      "url": "{{ canonical_url }}"
    }
  }
  </script>
  {{ content_for_header }}
  <style>
/* ═══════════════════════════════════════════════
   DESIGN « ATELIER » v2 — tokens
   Par boutique : "accent" (couleur douce), "accent_dark" (bandes sombres),
   "heading_font" : "sans" (défaut) ou "serif".
   ═══════════════════════════════════════════════ */
:root{
  --paper:#fafaf7;
  --panel:#f2f2ec;
  --card:#ffffff;
  --line:#e7e6df;
  --ink:#171816;
  --muted:#686a63;
  --accent:[[accent]];
  --accent-dark:[[accent_dark]];
  --accent-soft:color-mix(in srgb, var(--accent) 22%, #fff);
  --accent-pale:color-mix(in srgb, var(--accent) 10%, var(--paper));
  --sans:'Plus Jakarta Sans', ui-sans-serif, system-ui, -apple-system, sans-serif;
  --head:var(--sans);
  --wrap:1200px;
  --gutter:clamp(18px,4.5vw,48px);
  --r:22px;
  --r-sm:14px;
  --ease:cubic-bezier(.22,1,.36,1);
}
html.f-serif{--head:'Cormorant Garamond', Georgia, serif}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{display:block;max-width:100%;height:auto}
a{color:inherit;text-decoration:none}
ul{list-style:none}
button{font:inherit;color:inherit}
.wrap{width:100%;max-width:var(--wrap);margin:0 auto;padding:0 var(--gutter)}
.pill{display:inline-flex;align-items:center;gap:8px;align-self:flex-start;background:var(--accent-soft);color:var(--ink);font-size:13px;font-weight:600;padding:7px 14px;border-radius:999px}
.kicker{font-size:13px;font-weight:600;color:var(--accent-dark)}
.serif,.h{font-family:var(--head);font-weight:700;letter-spacing:-.035em;line-height:1.02}
html.f-serif .serif,html.f-serif .h{font-weight:600;letter-spacing:-.01em}
.serif em,.h em{font-style:normal;color:var(--accent-dark)}
.h2{font-size:clamp(28px,3.6vw,44px);margin:10px 0 0}
.lead{color:var(--muted);font-size:clamp(15.5px,1.3vw,17.5px);max-width:560px}
.sec{padding:clamp(56px,8vw,104px) 0}
.sec-head{display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px;margin-bottom:clamp(30px,4.5vw,52px)}
.sec-head .lead{margin:0 auto}
.rule{display:block;width:44px;height:2px;background:var(--accent);border-radius:2px;margin-top:6px}
.ico{flex:none;display:grid;place-items:center;border-radius:50%;background:var(--accent-soft)}
.ico svg{width:52%;height:52%;stroke:var(--ink);stroke-width:1.5;fill:none;stroke-linecap:round;stroke-linejoin:round}

/* ── boutons ── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:54px;padding:0 28px;border-radius:999px;font-size:15px;font-weight:600;cursor:pointer;border:1.5px solid var(--ink);transition:background .25s,color .25s,transform .25s var(--ease)}
.btn-ink{background:var(--ink);color:#fff}
.btn-ink:hover{background:#000;transform:translateY(-1px)}
.btn-line{background:transparent;color:var(--ink)}
.btn-line:hover{background:var(--ink);color:#fff}
.btn-soft{background:var(--accent);border-color:var(--accent);color:var(--ink)}
.btn-soft:hover{filter:brightness(1.06)}
.btn svg{width:17px;height:17px}

/* ── bandeau + en-tête ── */
.announce{background:var(--accent-dark);color:#f4f4ee;font-size:12.5px;font-weight:500;text-align:center;padding:9px 16px}
.head{position:sticky;top:0;z-index:50;background:rgba(250,250,247,.88);backdrop-filter:saturate(1.4) blur(12px);-webkit-backdrop-filter:saturate(1.4) blur(12px);border-bottom:1px solid transparent;transition:border-color .3s}
.head.is-stuck{border-bottom-color:var(--line)}
.head .wrap{display:flex;align-items:center;justify-content:space-between;height:70px;gap:16px}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--head);font-size:21px;font-weight:700;letter-spacing:-.02em}
.brand img{width:36px;height:36px;border-radius:50%;object-fit:cover}
.head-nav{display:flex;gap:30px;font-size:14px;font-weight:500;color:var(--muted)}
.head-nav a:hover{color:var(--ink)}
.head-cta{display:flex;align-items:center;gap:14px}
.head-price{font-size:14px;font-weight:700;white-space:nowrap}
.head .btn{min-height:44px;padding:0 22px;font-size:14px}

/* ── hero ── */
.hero{padding:clamp(24px,4vw,52px) 0 clamp(40px,6vw,80px)}
.hero-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:clamp(28px,5vw,64px);align-items:center}
.hero-copy{display:flex;flex-direction:column;gap:22px}
.hero h1{font-size:clamp(46px,6.6vw,86px)}
.hero h1 span{display:block}
.hero-sub{color:var(--muted);font-size:clamp(16px,1.5vw,18.5px);max-width:470px}
.price-row{display:flex;align-items:baseline;flex-wrap:wrap;gap:6px 14px}
.price-new{font-family:var(--head);font-size:clamp(32px,3.4vw,42px);font-weight:700;letter-spacing:-.03em;line-height:1}
.price-new small{font-family:var(--sans);font-size:14px;font-weight:700;margin-left:5px;letter-spacing:0}
.price-old{color:var(--muted);text-decoration:line-through;font-size:16px}
.badge{display:inline-block;background:var(--accent-soft);color:var(--ink);font-size:12.5px;font-weight:700;padding:5px 11px;border-radius:999px}
.hero-actions{display:flex;flex-wrap:wrap;align-items:center;gap:14px 22px}
.hero-note{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:500}
.hero-note .ico{width:34px;height:34px}

.gallery{position:relative;display:flex;flex-direction:column;gap:12px}
.g-main{position:relative;aspect-ratio:1/1.02;border-radius:calc(var(--r) + 10px);overflow:hidden;background:var(--accent-pale)}
.g-main::before{content:'';position:absolute;inset:auto -12% -30% 18%;height:80%;border-radius:50%;background:var(--accent-soft);filter:blur(2px)}
.g-main img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .45s ease}
.g-main img.is-fading{opacity:0}
.g-tag{position:absolute;right:16px;top:16px;background:#fff;font-size:12.5px;font-weight:700;padding:8px 14px;border-radius:999px;box-shadow:0 8px 20px -12px rgba(0,0,0,.35)}
.g-thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.g-thumbs button{aspect-ratio:1;border-radius:var(--r-sm);overflow:hidden;border:2px solid transparent;background:var(--panel);cursor:pointer;padding:0;opacity:.7;transition:opacity .25s,border-color .25s}
.g-thumbs button[aria-current="true"]{opacity:1;border-color:var(--ink)}
.g-thumbs img{width:100%;height:100%;object-fit:cover}

/* chiffres clés */
.stats{margin-top:clamp(28px,4vw,44px);background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:0 24px 50px -36px rgba(23,24,22,.35);display:grid;grid-template-columns:repeat(4,1fr)}
.stats li{display:flex;gap:12px;align-items:center;padding:18px 20px;border-left:1px solid var(--line)}
.stats li:first-child{border-left:0}
.stats .ico{width:40px;height:40px;background:var(--accent-pale)}
.stats b{display:block;font-size:15px;font-weight:700;line-height:1.2}
.stats span{display:block;font-size:12.5px;color:var(--muted);line-height:1.3}

/* ── cartes à icônes ── */
.features{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.feat{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:30px 22px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;transition:transform .35s var(--ease),box-shadow .35s}
.feat:hover{transform:translateY(-4px);box-shadow:0 22px 40px -30px rgba(23,24,22,.4)}
.feat .ico{width:62px;height:62px}
.feat h3{font-size:17px;font-weight:700;letter-spacing:-.01em;margin-top:4px}
.feat p{font-size:14px;color:var(--muted);line-height:1.5}

/* ── bande sombre (point fort) ── */
.dark{background:var(--accent-dark);color:#f3f3ee;border-radius:calc(var(--r) + 8px);padding:clamp(28px,5vw,64px);display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(24px,4vw,56px);align-items:center;overflow:hidden}
.dark .kicker{color:var(--accent)}
.dark h2{font-size:clamp(30px,3.8vw,48px);margin:10px 0 14px}
.dark p{color:rgba(243,243,238,.72);max-width:420px}
.dark-media{border-radius:var(--r);overflow:hidden;aspect-ratio:4/3}
.dark-media img{width:100%;height:100%;object-fit:cover}
.badges{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,1fr);gap:12px;border:1px solid rgba(255,255,255,.12);border-radius:var(--r);padding:18px}
.badges li{display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px;font-size:13.5px;line-height:1.35;color:rgba(243,243,238,.86)}
.badges .ico{width:52px;height:52px;background:var(--accent)}
.badges .ico svg{stroke:var(--accent-dark)}

/* ── avantages (photo + texte) ── */
.benefits{display:flex;flex-direction:column;gap:clamp(48px,7vw,96px)}
.benefit{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,6vw,80px);align-items:center}
.benefit:nth-child(even) .b-media{order:2}
.b-media{aspect-ratio:5/5.6;border-radius:var(--r);overflow:hidden;background:var(--panel)}
.b-media img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s var(--ease)}
.benefit:hover .b-media img{transform:scale(1.03)}
.b-copy{display:flex;flex-direction:column;gap:14px;max-width:460px}
.b-num{font-size:13px;font-weight:700;color:var(--accent-dark)}
.b-copy h3{font-size:clamp(28px,3vw,40px)}
.b-copy p{color:var(--muted);font-size:16.5px}
.b-copy .btn{align-self:flex-start;margin-top:8px}

/* ── inclus dans le colis ── */
.incl{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.incl figure{background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
.incl .im{aspect-ratio:1;background:var(--panel)}
.incl img{width:100%;height:100%;object-fit:cover}
.incl figcaption{padding:14px 16px;font-size:14.5px;font-weight:600;text-align:center}

/* ── détails / caractéristiques ── */
.details .wrap{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,6vw,80px);align-items:center}
.d-media{aspect-ratio:1;border-radius:var(--r);overflow:hidden;background:var(--panel)}
.d-media img{width:100%;height:100%;object-fit:cover}
.specs{margin-top:24px;background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:6px 22px}
.specs li{display:flex;justify-content:space-between;gap:20px;padding:15px 0;border-bottom:1px solid var(--line);font-size:15px}
.specs li:last-child{border-bottom:0}
.specs li span{color:var(--muted)}
.specs li b{font-weight:700;text-align:right}

/* ── étapes ── */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.step{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:clamp(24px,3vw,34px);display:flex;flex-direction:column;gap:10px}
.step-n{width:46px;height:46px;border-radius:50%;background:var(--accent-soft);display:grid;place-items:center;font-weight:800;font-size:18px}
.step h3{font-size:22px;margin-top:6px}
.step p{color:var(--muted);font-size:15px}

/* ── avis (affichés seulement s'il y en a de vrais) ── */
.reviews-wrap{background:var(--accent-pale);border-radius:calc(var(--r) + 8px);padding:clamp(28px,5vw,56px) clamp(18px,4vw,48px)}
.reviews{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.review{background:var(--card);border-radius:var(--r);padding:24px;display:flex;flex-direction:column;gap:12px;box-shadow:0 16px 34px -30px rgba(23,24,22,.4)}
.review p{font-size:15.5px;line-height:1.5}
.review cite{font-style:normal;font-size:13px;font-weight:600}
.stars{color:#e0a23b;letter-spacing:2px;font-size:14px}

/* ── offre ── */
.offer-card{display:grid;grid-template-columns:1.05fr 1fr;background:var(--card);border:1px solid var(--line);border-radius:calc(var(--r) + 8px);overflow:hidden}
.offer-media{background:var(--accent-pale);min-height:100%}
.offer-media img{width:100%;height:100%;object-fit:cover}
.offer-body{padding:clamp(26px,4.5vw,52px);display:flex;flex-direction:column;gap:16px}
.offer-body h2{font-size:clamp(28px,3.2vw,40px)}
.offer-body>p{color:var(--muted)}
.included li{display:flex;gap:11px;align-items:center;padding:6px 0;font-size:15px;font-weight:500}
.tick{flex:none;width:22px;height:22px;border-radius:50%;background:var(--accent-soft);display:grid;place-items:center}
.tick svg{width:11px;height:11px;stroke:var(--ink)}
.offer-price{display:flex;align-items:baseline;flex-wrap:wrap;gap:6px 14px;padding:16px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.offer-body .btn{width:100%}
.offer-foot{font-size:13px;color:var(--muted);text-align:center}

/* ── FAQ ── */
.faq{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:10px}
.faq details{background:var(--card);border:1px solid var(--line);border-radius:var(--r-sm);padding:0 20px}
.faq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:19px 0;font-size:16px;font-weight:600}
.faq summary::-webkit-details-marker{display:none}
.faq summary i{flex:none;position:relative;width:28px;height:28px;border-radius:50%;background:var(--accent-soft)}
.faq summary i::before,.faq summary i::after{content:'';position:absolute;left:8px;top:13.25px;width:12px;height:1.5px;background:var(--ink);transition:transform .3s var(--ease)}
.faq summary i::after{transform:rotate(90deg)}
.faq details[open] summary i::after{transform:rotate(0)}
.faq .a{padding:0 0 20px;color:var(--muted);max-width:700px}

/* ── appel final sombre ── */
.final{background:var(--accent-dark);color:#f3f3ee;border-radius:calc(var(--r) + 8px);padding:clamp(30px,5vw,60px);display:grid;grid-template-columns:1.3fr 1fr;gap:clamp(24px,4vw,48px);align-items:center;position:relative;overflow:hidden}
.final::after{content:'';position:absolute;right:-10%;top:-40%;width:55%;aspect-ratio:1;border-radius:50%;background:rgba(255,255,255,.04)}
.final h2{font-size:clamp(32px,4.4vw,56px)}
.final h2 em{color:var(--accent)}
.final p{color:rgba(243,243,238,.72);margin-top:14px;max-width:440px}
.price-card{position:relative;z-index:1;border:1px solid rgba(255,255,255,.16);border-radius:var(--r);padding:clamp(22px,3vw,32px);display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center;background:rgba(255,255,255,.04)}
.price-card .price-new{font-size:clamp(38px,4.4vw,54px);color:#fff}
.price-card .price-old{color:rgba(243,243,238,.55)}
.price-card .note{font-size:13.5px;color:rgba(243,243,238,.8)}
.price-card .btn{width:100%;margin-top:8px}
.foot{padding:30px 0 calc(30px + 76px)}
.foot .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:14px;font-size:13px;color:var(--muted)}
.foot .brand{font-size:18px;color:var(--ink)}

/* ── barre fixe mobile ── */
.bar{position:fixed;left:0;right:0;bottom:0;z-index:60;background:rgba(255,255,255,.96);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-top:1px solid var(--line);padding:10px var(--gutter) max(10px,env(safe-area-inset-bottom));display:flex;align-items:center;gap:14px;transform:translateY(110%);transition:transform .4s var(--ease)}
.bar.is-on{transform:none}
.bar-price{display:flex;flex-direction:column;line-height:1.15}
.bar-price b{font-size:17px}
.bar-price s{font-size:12px;color:var(--muted)}
.bar .btn{flex:1;min-height:52px;padding:0 18px;white-space:nowrap;font-size:15px}
@media (max-width:560px){.bar-price{display:none}}
@media (min-width:900px){.bar{display:none}.foot{padding-bottom:30px}}

/* ── apparition au défilement ── */
.rv{opacity:0;transform:translateY(22px);transition:opacity .9s var(--ease),transform .9s var(--ease)}
.rv.in{opacity:1;transform:none}
.no-js .rv{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}}

/* ── responsive ── */
@media (max-width:899px){
  .head-nav,.head-price{display:none}
  .head .wrap{height:60px}
  .hero{padding-top:14px}
  .hero-grid{grid-template-columns:1fr}
  .gallery{order:-1}
  .g-main{aspect-ratio:5/4.2}
  .g-thumbs{gap:8px}
  .hero-actions .btn{width:100%}
  .stats{grid-template-columns:1fr 1fr}
  .stats li{border-left:0;border-top:1px solid var(--line);padding:14px}
  .stats li:nth-child(-n+2){border-top:0}
  .stats li:nth-child(even){border-left:1px solid var(--line)}
  .features,.incl{grid-template-columns:1fr 1fr;gap:12px}
  .feat{padding:22px 14px}
  .feat .ico{width:52px;height:52px}
  .dark,.final,.benefit,.details .wrap,.offer-card{grid-template-columns:1fr}
  .dark-media{order:-1}
  .badges{grid-template-columns:1fr 1fr;gap:18px 10px}
  .benefit:nth-child(even) .b-media{order:0}
  .b-media{aspect-ratio:4/4.2}
  .steps{grid-template-columns:1fr}
  .offer-media{aspect-ratio:4/3}
}
@media (max-width:420px){.brand{font-size:19px}.head .btn{padding:0 16px}.stats b{font-size:14px}}

/* ── panneau de commande (formulaire COD de l'app) ── */
html.order-open,html.order-open body{overflow:hidden}
.order-panel{position:fixed;inset:0;z-index:130;visibility:hidden;pointer-events:none;display:flex;align-items:flex-end;justify-content:center}
.order-panel.is-open{visibility:visible;pointer-events:auto}
.order-backdrop{position:absolute;inset:0;background:rgba(20,21,18,.5);opacity:0;transition:opacity .35s ease}
.order-panel.is-open .order-backdrop{opacity:1}
/* jamais de transform sur la feuille ouverte : sinon les pop-ups de l'app COD disparaissent */
.order-sheet{position:relative;z-index:1;width:min(620px,100%);max-height:92vh;max-height:92dvh;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;background:#fff;color:var(--ink);border-radius:24px 24px 0 0;padding:22px clamp(16px,4vw,30px) max(24px,env(safe-area-inset-bottom));outline:none;text-align:left}
.order-panel.is-open .order-sheet{animation:atSheetUp .42s cubic-bezier(.22,1,.36,1) backwards}
@keyframes atSheetUp{from{transform:translateY(60px);opacity:0}to{transform:none;opacity:1}}
@media (min-width:760px){.order-panel{align-items:center}.order-sheet{border-radius:24px;max-height:88vh}}
.order-close{position:sticky;top:0;float:right;margin:-8px -6px 0 0;width:40px;height:40px;border:0;border-radius:50%;background:var(--panel);font-size:24px;line-height:1;cursor:pointer;z-index:2}
.order-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;padding:2px 44px 16px 0;margin-bottom:12px;border-bottom:1px solid var(--line)}
.order-title{flex-basis:100%;font-family:var(--head);font-size:22px;font-weight:700;letter-spacing:-.02em;line-height:1.2;margin-bottom:4px}
.order-old{text-decoration:line-through;color:var(--muted);font-size:14px}
.order-new{font-size:22px;font-weight:800}
.order-note{flex-basis:100%;font-size:12.5px;font-weight:600;color:var(--accent-dark)}
.cod-box{overflow:visible}
.cod-box *{color:inherit}
.cod-box .mm-native label{display:block;font-size:14px;margin:0 0 6px}
.cod-box .mm-native select{width:100%;font:inherit;padding:12px;border:1px solid var(--line);border-radius:12px;background:#fff;margin-bottom:14px}
.cod-box .mm-native .mm-title{font-size:17px;font-weight:700;margin-bottom:14px}
.cod-box .mm-native .btn-order{width:100%;min-height:54px;border:0;border-radius:999px;background:var(--ink);color:#fff;font-size:16px;font-weight:600;cursor:pointer}
  </style>
</head>
<body class="no-js">

  <div class="announce">[[announcement]]</div>

  <header class="head" id="head">
    <div class="wrap">
      <a class="brand" href="#top" aria-label="[[brand]]"><img src="{{ '[[logo_file]]' | asset_url }}" alt="" width="32" height="32">[[brand]]</a>
      <nav class="head-nav" aria-label="Sections">
        <a href="#avantages">Avantages</a>
        <a href="#details">Détails</a>
        <a href="#livraison">Livraison</a>
        <a href="#questions">Questions</a>
      </nav>
      <div class="head-cta">
        <span class="head-price">{{ mm_new }} {{ mm_cur }}</span>
        <a class="btn btn-ink" href="#commander" data-order>Commander</a>
      </div>
    </div>
  </header>

  <main id="top">

    <!-- ═════ HERO ═════ -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <span class="pill rv">[[hero_kicker]]</span>
          <h1 class="h rv">[[hero_title_html]]</h1>
          <p class="hero-sub rv">[[hero_sub]]</p>
          <div class="price-row rv">
            <span class="price-new">{{ mm_new }}<small>{{ mm_cur }}</small></span>
            <span class="price-old">{{ mm_old }} {{ mm_cur }}</span>
            <span class="badge">−[[save_pct]] %</span>
          </div>
          <div class="hero-actions rv">
            <a class="btn btn-ink" href="#commander" data-order id="heroOrder">Commander maintenant<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
            <span class="hero-note"><span class="ico">[[cash_icon]]</span>Paiement à la livraison</span>
          </div>
        </div>
        <div class="gallery rv">
          <div class="g-main">
            <img id="gMain" src="{{ '[[img]][[hero_image]]' | asset_url }}" alt="[[hero_alt]]" width="1000" height="1000" fetchpriority="high">
            <span class="g-tag">[[hero_tag]]</span>
          </div>
          <div class="g-thumbs" role="group" aria-label="Photos du produit">
[[thumbs_html]]
          </div>
        </div>
      </div>
      <div class="wrap">
        <ul class="stats rv" aria-label="En bref">
[[stats_html]]
        </ul>
      </div>
    </section>

    <!-- ═════ CARTES À ICÔNES ═════ -->
    <section class="sec" id="avantages" style="padding-top:clamp(24px,4vw,48px)">
      <div class="wrap">
        <div class="sec-head rv">
          <h2 class="h h2">[[features_title]]</h2>
          <span class="rule"></span>
        </div>
        <div class="features">
[[features_html]]
        </div>
      </div>
    </section>

    <!-- ═════ POINT FORT (bande sombre) ═════ -->
    <section style="padding-bottom:clamp(56px,8vw,104px)">
      <div class="wrap">
        <div class="dark rv">
          <div>
            <p class="kicker">[[highlight_kicker]]</p>
            <h2 class="h">[[highlight_title]]</h2>
            <p>[[highlight_text]]</p>
          </div>
          <div class="dark-media"><img src="{{ '[[img]][[highlight_image]]' | asset_url }}" alt="[[highlight_alt]]" loading="lazy"></div>
          <ul class="badges">
[[badges_html]]
          </ul>
        </div>
      </div>
    </section>

    <!-- ═════ AVANTAGES EN SITUATION ═════ -->
    <section class="sec" style="padding-top:0">
      <div class="wrap benefits">
[[benefits_html]]
      </div>
    </section>

    <!-- ═════ INCLUS ═════ -->
    <section class="sec" style="padding-top:0">
      <div class="wrap">
        <div class="sec-head rv">
          <h2 class="h h2">[[incl_title]]</h2>
          <span class="rule"></span>
        </div>
        <div class="incl">
[[incl_html]]
        </div>
      </div>
    </section>

    <!-- ═════ DÉTAILS ═════ -->
    <section class="sec details" id="details" style="padding-top:0">
      <div class="wrap">
        <div class="d-media rv"><img src="{{ '[[img]][[details_image]]' | asset_url }}" alt="[[details_alt]]" loading="lazy"></div>
        <div class="rv">
          <p class="kicker">[[details_kicker]]</p>
          <h2 class="h h2">[[details_title]]</h2>
          <ul class="specs">
[[specs_html]]
          </ul>
        </div>
      </div>
    </section>

[[reviews_section]]

    <!-- ═════ ÉTAPES ═════ -->
    <section class="sec" id="livraison" style="padding-top:0">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="kicker">[[steps_kicker]]</p>
          <h2 class="h h2">[[steps_title]]</h2>
        </div>
        <div class="steps">
[[steps_html]]
        </div>
      </div>
    </section>

    <!-- ═════ OFFRE ═════ -->
    <section class="sec" id="offre" style="padding-top:0">
      <div class="wrap">
        <div class="offer-card rv">
          <div class="offer-media"><img src="{{ '[[img]][[offer_image]]' | asset_url }}" alt="[[offer_alt]]" loading="lazy"></div>
          <div class="offer-body">
            <span class="pill">[[offer_kicker]]</span>
            <h2 class="h">[[offer_title]]</h2>
            <p>[[offer_text]]</p>
            <ul class="included">
[[included_html]]
            </ul>
            <div class="offer-price">
              <span class="price-new">{{ mm_new }}<small>{{ mm_cur }}</small></span>
              <span class="price-old">{{ mm_old }} {{ mm_cur }}</span>
              <span class="badge">−[[save_pct]] %</span>
            </div>
            <a class="btn btn-ink" href="#commander" data-order>Commander — payer à la livraison</a>
            <p class="offer-foot">[[offer_foot]]</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═════ FAQ ═════ -->
    <section class="sec" id="questions" style="padding-top:0">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="kicker">Questions fréquentes</p>
          <h2 class="h h2">[[faq_title]]</h2>
        </div>
        <div class="faq rv">
[[faq_html]]
        </div>
      </div>
    </section>

    <!-- ═════ APPEL FINAL ═════ -->
    <section style="padding-bottom:clamp(40px,6vw,72px)">
      <div class="wrap">
        <div class="final rv">
          <div>
            <h2 class="h">[[final_title_a]] <em>[[final_title_em]]</em></h2>
            <p>[[final_text]]</p>
          </div>
          <div class="price-card">
            <span class="price-new">{{ mm_new }}<small>{{ mm_cur }}</small></span>
            <span class="price-old">{{ mm_old }} {{ mm_cur }}</span>
            <span class="note">[[final_note]]</span>
            <a class="btn btn-soft" href="#commander" data-order id="finalOrder">Commander maintenant<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <span class="brand">[[brand]]</span>
      <span>[[footer_note]]</span>
      <span>© {{ 'now' | date: '%Y' }} [[brand]]</span>
    </div>
  </footer>

  <!-- ═════ BARRE FIXE MOBILE ═════ -->
  <div class="bar" id="bar">
    <div class="bar-price"><b>{{ mm_new }} {{ mm_cur }}</b><s>{{ mm_old }} {{ mm_cur }}</s></div>
    <a class="btn btn-ink" href="#commander" data-order>Acheter maintenant · {{ mm_new }} {{ mm_cur }}</a>
  </div>

  <!-- ═════ PANNEAU DE COMMANDE (formulaire COD) ═════ -->
  <div class="order-panel" id="orderPanel" aria-hidden="true">
    <div class="order-backdrop" data-close></div>
    <div class="order-sheet" id="commander" role="dialog" aria-modal="true" aria-label="Commander : [[ld_name]]" tabindex="-1">
      <button type="button" class="order-close" data-close aria-label="Fermer">&times;</button>
      <div class="order-head">
        <span class="order-title">[[ld_name]]</span>
        <span class="order-new">{{ mm_new }} {{ mm_cur }}</span>
        <span class="order-old">{{ mm_old }} {{ mm_cur }}</span>
        <span class="order-note">Paiement à la livraison — nous vous appelons pour confirmer</span>
      </div>
      <div class="cod-box">
        {{ content_for_layout }}
      </div>
    </div>
  </div>

  <script>
(function(){
  var d=document, root=d.documentElement;
  d.body.classList.remove('no-js');

  /* apparition douce au défilement */
  var rv=[].slice.call(d.querySelectorAll('.rv'));
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{rootMargin:'0px 0px -8% 0px',threshold:.08});
    rv.forEach(function(el){io.observe(el);});
  } else rv.forEach(function(el){el.classList.add('in');});

  /* galerie : vignettes → grande image */
  var main=d.getElementById('gMain');
  [].forEach.call(d.querySelectorAll('.g-thumbs button'),function(b,i,all){
    b.addEventListener('click',function(){
      if(b.getAttribute('aria-current')==='true') return;
      [].forEach.call(all,function(x){x.setAttribute('aria-current','false');});
      b.setAttribute('aria-current','true');
      main.classList.add('is-fading');
      setTimeout(function(){main.src=b.getAttribute('data-src');main.alt=b.getAttribute('data-alt');main.onload=function(){main.classList.remove('is-fading');};setTimeout(function(){main.classList.remove('is-fading');},500);},220);
    });
  });

  /* en-tête : filet quand on défile */
  var head=d.getElementById('head');
  function onScroll(){head.classList.toggle('is-stuck',window.scrollY>8);}
  window.addEventListener('scroll',onScroll,{passive:true}); onScroll();

  /* panneau de commande */
  var panel=d.getElementById('orderPanel'), sheet=d.getElementById('commander'), bar=d.getElementById('bar'), last=null;
  var heroVis=true, finalVis=false;
  function updateBar(){ if(bar) bar.classList.toggle('is-on', !heroVis && !finalVis && !panel.classList.contains('is-open')); }
  function open(){
    last=d.activeElement;
    panel.classList.add('is-open'); panel.setAttribute('aria-hidden','false');
    root.classList.add('order-open'); updateBar();
    sheet.scrollTop=0; setTimeout(function(){try{sheet.focus({preventScroll:true});}catch(e){}},60);
  }
  function close(){
    panel.classList.remove('is-open'); panel.setAttribute('aria-hidden','true');
    root.classList.remove('order-open'); updateBar();
    if(last&&last.focus){try{last.focus({preventScroll:true});}catch(e){}}
  }
  if('IntersectionObserver' in window){
    var h=d.getElementById('heroOrder'), f=d.getElementById('finalOrder');
    var ob=new IntersectionObserver(function(es){es.forEach(function(e){
      if(e.target===h) heroVis=e.isIntersecting||e.boundingClientRect.top>0; else finalVis=e.isIntersecting;
    }); updateBar();},{threshold:0});
    ob.observe(h); ob.observe(f);
  } else { heroVis=false; updateBar(); }
  d.addEventListener('click',function(e){
    var t=e.target.closest&&e.target.closest('[data-order],[data-close]');
    if(!t) return;
    e.preventDefault(); e.stopPropagation();
    if(t.hasAttribute('data-close')) close(); else open();
  },true);
  d.addEventListener('keydown',function(e){ if(e.key==='Escape'&&panel.classList.contains('is-open')) close(); });
  if(location.hash==='#commander') setTimeout(open,600);
  window.mmOrder={open:open,close:close};
})();
  </script>
</body>
</html>
