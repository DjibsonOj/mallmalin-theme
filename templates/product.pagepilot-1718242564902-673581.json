alignment":"center","padding_top":36,"padding_bottom":36}},"image_with_text_HTJx4d":{"type":"image-with-text","blocks":{"heading_6ncncP":{"type":"heading","settings":{"heading":"Marre que votre téléphone glisse partout ? 📱","heading_size":"h1"}},"text_gz7dJe":{"type":"text","settings":{"text":"<p>Les supports de téléphone traditionnels ne tiennent pas toujours en place, surtout sur les routes accidentées. Notre Support Téléphone Voiture Rotatif LISEN® est équipé d’une base en silicone antidérapante qui assure que votre téléphone reste bien en place, peu importe les conditions de la route.<\/p>","text_style":"body"}},"button_Je6MjT":{"type":"button","settings":{"button_label":"👉🏻 Ajouter au panier","button_link":"#","button_style_secondary":false}}},"block_order":["heading_6ncncP","text_gz7dJe","button_Je6MjT"],"settings":{"image":"shopify:\/\/shop_images\/image_710_1718242055063-9390276-22403935-47824336_3.webp","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"middle","desktop_content_alignment":"center","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"center","padding_top":36,"padding_bottom":36}},"multicolumn_zAPEYb":{"type":"multicolumn","blocks":{"column_niUwaX":{"type":"column","settings":{"title":"","text":"<p>★★★★★<\/p><p>Mon achat préféré de l’année ! Le support est solide, pratique et maintient mon téléphone en toute sécurité.<\/p>","link_label":"- François Y.","link":""}},"column_zwY4Mf":{"type":"column","settings":{"title":"","text":"<p>★★★★★<\/p><p>Super produit ! La qualité est au rendez-vous et il tient parfaitement sur mon tableau de bord. C’est simple mais ça change tout.<\/p>","link_label":"- Jean X.","link":""}},"column_cpEFdK":{"type":"column","settings":{"title":"","text":"<p>★★★★★<\/p><p>Depuis que j'ai ce support, mes trajets sont beaucoup plus confortables. Finis les moments de panique à chercher mon téléphone lorsque 