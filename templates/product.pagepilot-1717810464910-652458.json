t":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":36,"padding_bottom":0}},"aaa0fc37-5325-459c-9f2e-8335903bc034":{"type":"image-with-text","blocks":{"template--20358512345391__aaa0fc37-5325-459c-9f2e-8335903bc034-heading-1":{"type":"heading","settings":{"heading":"Découvrez le confort ultime en voyage ✨","heading_size":"h2"}},"template--20358512345391__aaa0fc37-5325-459c-9f2e-8335903bc034-text-1":{"type":"text","settings":{"text":"<p>Grâce à sa conception ergonomique et sa mousse à mémoire de forme, cet oreiller enveloppe votre cou pour un soutien optimal. Il aide non seulement à réduire le stress et les douleurs cervicales, mais favorise également un endormissement rapide et un maintien du sommeil. Plus besoin de vous inquiéter du décalage horaire, réveillez-vous au TOP de votre forme!<\/p>","text_style":"body"}},"template--20358512345391__aaa0fc37-5325-459c-9f2e-8335903bc034-button-1":{"type":"button","settings":{"button_label":"👉🏻 Je le veux","button_link":"","button_style_secondary":false}}},"block_order":["template--20358512345391__aaa0fc37-5325-459c-9f2e-8335903bc034-heading-1","template--20358512345391__aaa0fc37-5325-459c-9f2e-8335903bc034-text-1","template--20358512345391__aaa0fc37-5325-459c-9f2e-8335903bc034-button-1"],"custom_css":[".image-with-text__content a.button--primary {width: 100% !important;}"],"settings":{"image":"shopify:\/\/shop_images\/Support_360.png","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"middle","desktop_content_alignment":"left","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":36,"padding_bottom":0}},"5519dfae-a9d1-4a84-be5b-5d728f8d04a6":{"type":"image-with-text","blocks":{"template--20358512345391__5519dfae-a9d1-4a84-be5b-5d728f8d04a6-heading-1":{"type":"heading","settings":{"heading":"Problème du jet lag? Nous avons la solution! ✈️","heading_size":"h2"}},"template--20358512345391__5519dfae-a9d1-4a84-be5b-5d728f8d04a6-text-1":{"type":"text","settings":{"text":"<p>Le jet lag peut être un véritable défi, surtout après de longs vols. Notre Oreiller de Voyage en Mousse à Mémoire est spécialement conçu pour aider votre corps à se remettre rapidement. En assurant un confort cervical et en facilitant une bonne nuit de sommeil, il permet une récupération plus rapide après le décalage horaire. Profitez pleinement de votre voyage dès le premier jour!<\/p>","text_style":"body"}},"template--20358512345391__5519dfae-a9d1-4a84-be5b-5d728f8d04a6-button-1":{"type":"button","settings":{"button_label":"👉🏻 Ajouter au panier","button_link":"","button_style_secondary":false}}},"block_order":["template--20358512345391__5519dfae-a9d1-4a84-be5b-5d728f8d04a6-heading-1","template--20358512345391__5519dfae-a9d1-4a84-be5b-5d728f8d04a6-text-1","template--20358512345391__5519dfae-a9d1-4a84-be5b-5d728f8d04a6-button-1"],"custom_css":[".image-with-text__content a.button--primary {width: 100% !important;}"],"settings":{"image":"shopify:\/\/shop_images\/chrome-capture_-_2024-06-08T050308.909.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"middle","desktop_content_alignment":"left","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":36,"padding_bottom":0}},"f9625dd6-5a6d-43e5-86e9-07a0b8b0555a":{"type":"multicolumn","blocks":{"template--20358512345391__f9625dd6-5a6d-43e5-86e9-07a0b8b0555a-column-1":{"type":"column","settings":{"title":"Catherine B.","text":"<p>\"Cet oreiller a complètement changé mes voyages! Tellement confortable que je m'endors facilement et me réveille sans douleur. ✈️\"<\/p>","link_label":"★★★★★","link":""}},"10dc0835-e8bc-4506-bddd-796d410d3246":{"type":"column","settings":{"title":"Sophie E.","text":"<p>\"Produit incroyable! Je souffrais souvent de douleurs cervicales après les vols. Depuis que j'utilise cet oreiller, je me sens beaucoup mieux. Il est doux et ne se déforme pas. Excellent investissement pour les voyageurs fréquents.\"<\/p>","link_label":"★★★★★","link":""}},"5af2b006-622b-419e-af94-db0639a87d07":{"type":"column","settings":{"title":"Élise W.","text":"<p>\"Le meilleur oreiller de voyage que j'ai essayé! Récupération rapide après le jet lag et maintien parfait du sommeil.\"<\/p>","link_label":"★★★★★","link":""}}},"block_order":["template--20358512345391__f9625dd6-5a6d-43e5-86e9-07a0b8b0555a-column-1","10dc0835-e8bc-4506-bddd-796d410d3246","5af2b006-622b-419e-af94-db0639a87d07"],"custom_css":[".multicolumn-card__image-wrapper .media {padding: 35px 0 !important;}",".multicolumn-card__image-wrapper .media img {border-radius: 100%; max-height: 75px; right: 0; left: 0; margin: auto;}",".multicolumn-card {background: #ffffff8f !important; box-shadow: rgba(112, 144, 176, 0.08) 14px 17px 40px 4px;}",".multicolumn-card__info h3 {font-weight: 700;}",".multicolumn-card__info {text-align: center;}",".multicolumn-card__info a.link span {display: none;}","h2.title {margin: auto;}"],"settings":{"title":"Avis Certifiés","heading_size":"h1","image_width":"full","image_ratio":"adapt","columns_desktop":3,"column_alignment":"left","background_style":"primary","button_label":"","button_link":"","color_scheme":"","columns_mobile":"1","swipe_on_mobile":false,"padding_top":36,"padding_bottom":36}},"18f5c195-5411-4a2f-a8b8-d5b280e2dcf5":{"type":"image-with-text","blocks":{"template--20352284950831__18f5c195-5411-4a2f-a8b8-d5b280e2dcf5-heading-1":{"type":"heading","settings":{"heading":"Commandez votre Oreiller de Voyage en Mousse à Mémoire dès maintenant et profitez de notre garantie satisfait ou remboursé de 30 jours!","heading_size":"h1"}},"template--20352284950831__18f5c195-5411-4a2f-a8b8-d5b280e2dcf5-text-1":{"type":"text","settings":{"text":"<p>Mettez à niveau votre expérience de voyage et découvrez les avantages extraordinaires de notre Oreiller de Voyage en Mousse à Mémoire sans risque. Si vous n'êtes pas pleinement satisfait, nous vous remboursons sous 30 jours. Qu'attendez vous pour ressentir le confort ultime ?<\/p>","text_style":"subtitle"}},"template--20352284950831__18f5c195-5411-4a2f-a8b8-d5b280e2dcf5-button-1":{"type":"button","settings":{"button_label":"👉🏻 Je le veux","button_link":"","button_style_secondary":false}}},"block_order":["template--20352284950831__18f5c195-5411-4a2f-a8b8-d5b280e2dcf5-heading-1","template--20352284950831__18f5c195-5411-4a2f-a8b8-d5b280e2dcf5-text-1","template--20352284950831__18f5c195-5411-4a2f-a8b8-d5b280e2dcf5-button-1"],"custom_css":[".image-with-text__media-item {display: none;}","h2 {text-align: center; margin-left: auto; margin-right: auto;}",".image-with-text__text {text-align: center; margin-left: auto; margin-right: auto;}","a.button {margin-left: auto; margin-right: auto; width: 100%; max-width: 450px;}"],"settings":{"height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"background-1","image_behavior":"none","mobile_content_alignment":"left","padding_top":12,"padding_bottom":36}},"1ade678e-7209-4a85-a19f-3036590ddf83":{"type":"custom-liquid","settings":{"custom_liquid":"<script> \n\nlet buttonIdentifier = 'a.button--primary';\nlet cartIdentifier = '.form button[type=\"submit\"]';\n\n\n\n\nfunction triggerAtcButton(event) {\n\t\t\t\nconst hrefAttr = event.currentTarget.getAttribute('href');\n\t\t\t\t\t\t\t\nif (hrefAttr && hrefAttr.trim() !== '') {\n\n  if( hrefAttr == '#' ) {\n\n  } else {\n    return;\n  }\n}\n\n  event.preventDefault();\n\n  let cartButton = document.querySelector(cartIdentifier);\n\n  if(cartButton) {\n    cartButton.click();\n    window.scrollTo({ top: 0, behavior: 'smooth' });\n    return;    \n  }\n\n\n  const elementsToSearch = [\n    '.add-to-cart',\n    '.addCart',\n    '.atc',\n    '.new-form-atc',\n    '.add-item',\n    '#new-form-atc',\n    '#add-to-cart',\n    '#atc',\n    '.btn-add-to-cart',\n    '.add_to_cart',\n    '.btn-add-to-cart',\n    '#add-to-cart-button',\n    '#addtocart',\n    '.addToCart',\n    '.js-add-to-cart',\n    '#addToCart',\n    '.product__add-to-cart',\n    '.buy-btn',\n    '.cart-btn',\n    '.product-add',\n    '.btn-cart',\n    '.btn-add',\n    '#add-button',\n    '.cart-add',\n    '.js-add-to-cart-btn',\n    '#add-button-cart',\n    '.buy-button',\n    '.add-to-cart-btn',\n    '#btn-add-to-cart',\n    '.cart-action',\n    '.product-cart-btn',\n    '#product-add-to-cart',\n    '.atc-button',\n    '.product-form__buttons .product-form__submit',\n    '#cart-add-button',\n    '.btn-cart-add',\n    '.btn-add-cart',\n    '.add-to-basket',\n    '#add-to-basket-btn',\n    '.add-to-trolley',\n    '.trolley-add',\n    '.buy-now-btn',\n    '#add-to-bag',\n    '#add-to-cart-btn',\n    '.product-addtocart',\n    '.cart-add-btn',\n    '#cart-add-to-cart',\n    '.product-form__submit',\n    '.product-form__buttons button[type=submit]'\n  ];\n\n  let foundElement = elementsToSearch.find(selector => document.querySelector(selector));\n\n  if (foundElement) {\n    console.log(foundElement);\n    return;\n    document.querySelector(foundElement).click();\n    window.scrollTo({ top: 0, behavior: 'smooth' });\n    return;\n  }\n\n  let addButton = document.querySelector('button[type=\"submit\"]');\n\n  if (addButton) {\n    addButton.click();\n    window.scrollTo({ top: 0, behavior: 'smooth' });\n    return;\n  }  \n\n  window.scrollTo({ top: 0, behavior: 'smooth' });\n}\n\nconst btnElements = document.querySelectorAll(buttonIdentifier);\n\nbtnElements.forEach(btn => {\n  btn.addEventListener('click', triggerAtcButton);\n\n  btn.setAttribute('aria-disabled', 'false');\n\n  btn.style.cursor = 'pointer';\n});\n<\/script>","color_scheme":"","padding_top":0,"padding_bottom":0}}},"order":["