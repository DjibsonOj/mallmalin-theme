{%- comment -%}
  Design « Sur-Mesure » — landing adaptée à chaque produit : un style visuel (data-style)
  et une liste de sections choisies dans le fichier produit. Fichier GÉNÉRÉ par tools/build.py :
  ne pas éditer layout/landing-*.liquid à la main.
  ► Pixel : AUCUN pixel ici. {{ content_for_header }} charge celui de la boutique.
  ► Formulaire COD : section mm-cod ({{ content_for_layout }}) dans le panneau #commander.
{%- endcomment -%}
{%- assign mm_new = '14 900' -%}
{%- assign mm_old = '24 900' -%}
{%- assign mm_cur = 'FCFA' -%}
{%- assign mm_new_num = '14900' -%}
<!DOCTYPE html>
<html lang="fr" class="" data-style="tech" data-hero="split">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Inclinomètre numérique laser magnétique rechargeable | {{ mm_new }} {{ mm_cur }} · Paiement à la livraison</title>
  <meta name="description" content="Inclinomètre numérique avec laser rouge et fixation magnétique : angle en degrés, pente en %, touches HOLD et ZERO, batterie rechargeable. {{ mm_new }} {{ mm_cur }}, housse et câble inclus, paiement à la livraison.">
  <meta name="theme-color" content="#0c0e12">
  <link rel="canonical" href="{{ canonical_url }}">
  <meta property="og:type" content="product">
  <meta property="og:title" content="Inclinomètre numérique laser magnétique">
  <meta property="og:description" content="Angles et pentes affichés en chiffres, laser rouge, fixation magnétique. {{ mm_new }} {{ mm_cur }} — paiement à la livraison.">
  <meta property="og:image" content="https:{{ 'ab-inclino-hero.jpg' | asset_url }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:locale" content="fr_FR">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="{{ 'ab-favicon.png' | asset_url }}">
  <link rel="preload" as="image" href="{{ 'ab-inclino-hero.jpg' | asset_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Inclinomètre numérique laser magnétique rechargeable",
    "description": "Inclinomètre numérique à écran, avec ligne laser rouge, fixation magnétique, mesure de l'angle en degrés et de la pente en %, fonctions HOLD et ZERO, batterie rechargeable. Livré avec housse et câble de charge.",
    "image": "https:{{ 'ab-inclino-hero.jpg' | asset_url }}",
    "brand": { "@type": "Brand", "name": "Afribazaar" },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "XOF",
      "price": "{{ mm_new_num }}",
      "availability": "https://schema.org/InStock",
      "url": "{{ canonical_url }}"
    }
  }
  </script>
  {{ content_for_header }}
  <style>
/* ═══════════════════════════════════════════════
   DESIGN « SUR-MESURE » — un socle, sept directions artistiques.
   Le style se choisit par "style" dans le fichier produit ;
   chaque couleur peut être surchargée ("colors").
   ═══════════════════════════════════════════════ */
:root{
  --bg:#fafaf8;--surface:#fff;--ink:#16171a;--muted:#646873;--line:#e6e6e2;
  --accent:#16171a;--accent-ink:#fff;--accent2:var(--accent);
  --r:18px;--btn-r:999px;
  --fh:system-ui,sans-serif;--fb:system-ui,sans-serif;--hw:700;--ht:none;--hls:-.03em;--hlh:1.02;
  --wrap:1200px;--gutter:clamp(18px,4.5vw,48px);--ease:cubic-bezier(.22,1,.36,1);
  --soft:color-mix(in srgb,var(--accent) 14%,var(--surface));
  --pale:color-mix(in srgb,var(--accent) 7%,var(--bg));
  --shadow:0 26px 50px -34px rgba(0,0,0,.35);
}
html[data-style="tech"]{--bg:#0c0e12;--surface:#151920;--ink:#eef2f7;--muted:#8d97a6;--line:rgba(255,255,255,.09);--accent:#4fd1ff;--accent-ink:#03121a;--accent2:#8b7bff;--r:16px;--fh:'Space Grotesk',sans-serif;--fb:'Inter',sans-serif;--hw:600;--hls:-.035em;--shadow:0 30px 60px -30px rgba(0,0,0,.8)}
html[data-style="beaute"]{--bg:#fbf6f2;--surface:#fff;--ink:#2b2220;--muted:#8a7a74;--line:#eedfd6;--accent:#c47a84;--accent-ink:#fff;--accent2:#d9b08c;--r:28px;--fh:'Cormorant Garamond',serif;--fb:'DM Sans',sans-serif;--hw:600;--hls:-.01em;--hlh:1.04}
html[data-style="sante"]{--bg:#f5f8fc;--surface:#fff;--ink:#10243e;--muted:#56677d;--line:#dbe5f0;--accent:#1f6feb;--accent-ink:#fff;--accent2:#14b8a6;--r:14px;--fh:'Manrope',sans-serif;--fb:'Manrope',sans-serif;--hw:800;--hls:-.035em}
html[data-style="maison"]{--bg:#f7f2ea;--surface:#fffdf9;--ink:#2d241c;--muted:#7d6f60;--line:#e7dccd;--accent:#c4693d;--accent-ink:#fff;--accent2:#6b8f5e;--r:20px;--fh:'Fraunces',serif;--fb:'Inter',sans-serif;--hw:600;--hls:-.02em;--hlh:1.05}
html[data-style="mode"]{--bg:#fff;--surface:#f3f3f2;--ink:#0a0a0a;--muted:#6b6b6b;--line:#e3e3e3;--accent:#0a0a0a;--accent-ink:#fff;--accent2:#b08d57;--r:0px;--btn-r:0px;--fh:'Bodoni Moda',serif;--fb:'Jost',sans-serif;--hw:500;--hls:-.02em;--hlh:1}
html[data-style="sport"]{--bg:#0b0b0b;--surface:#161616;--ink:#f5f5f5;--muted:#9c9c9c;--line:rgba(255,255,255,.1);--accent:#c6ff3d;--accent-ink:#0b0b0b;--accent2:#ff4d2e;--r:10px;--btn-r:10px;--fh:'Barlow Condensed',sans-serif;--fb:'Barlow',sans-serif;--hw:800;--ht:uppercase;--hls:-.01em;--hlh:.92;--shadow:0 30px 60px -30px rgba(0,0,0,.8)}
html[data-style="enfants"]{--bg:#fffaf0;--surface:#fff;--ink:#2a2a3c;--muted:#6b6b80;--line:#f1e5cf;--accent:#ff7a59;--accent-ink:#fff;--accent2:#3dbf9f;--r:26px;--fh:'Baloo 2',sans-serif;--fb:'Nunito',sans-serif;--hw:800;--hls:-.01em;--hlh:1}
html[data-style="tech"]{--accent:#38e07b;--accent-ink:#04140a;--accent2:#ff4040}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{background:var(--bg);color:var(--ink);font-family:var(--fb);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{display:block;max-width:100%;height:auto}
a{color:inherit;text-decoration:none}
ul{list-style:none}
button{font:inherit;color:inherit}
.wrap{width:100%;max-width:var(--wrap);margin:0 auto;padding:0 var(--gutter)}
.h{font-family:var(--fh);font-weight:var(--hw);letter-spacing:var(--hls);line-height:var(--hlh);text-transform:var(--ht)}
.h em{font-style:normal;color:var(--accent)}
html[data-style="beaute"] .h em,html[data-style="mode"] .h em,html[data-style="maison"] .h em{font-style:italic}
html[data-style="mode"] .h em{color:var(--accent2)}
.h2{font-size:clamp(30px,3.8vw,48px)}
.kicker{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
html[data-style="mode"] .kicker{color:var(--muted)}
.pill{display:inline-flex;align-self:flex-start;align-items:center;gap:8px;background:var(--soft);color:var(--ink);font-size:13px;font-weight:600;padding:7px 14px;border-radius:999px}
html[data-style="mode"] .pill{border-radius:0;background:transparent;border:1px solid var(--ink);text-transform:uppercase;letter-spacing:.12em;font-size:11px}
.lead{color:var(--muted);font-size:clamp(15.5px,1.3vw,17.5px);max-width:600px}
.sec{padding:clamp(56px,8vw,104px) 0}
.sec.tint{background:var(--pale)}
.sec-head{display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;margin-bottom:clamp(30px,4.5vw,52px)}
.sec-head .lead{margin:0 auto}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r)}
.ico{flex:none;display:grid;place-items:center;border-radius:50%;background:var(--soft);width:52px;height:52px}
html[data-style="mode"] .ico{border-radius:0}
.ico svg{width:50%;height:50%;stroke:var(--ink);stroke-width:1.6;fill:none;stroke-linecap:round;stroke-linejoin:round}
html[data-style="tech"] .ico svg,html[data-style="sport"] .ico svg{stroke:var(--accent)}
.tick{flex:none;width:22px;height:22px;border-radius:50%;background:var(--soft);display:grid;place-items:center}
.tick svg{width:11px;height:11px;stroke:var(--ink);stroke-width:2;fill:none}

/* boutons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:54px;padding:0 28px;border-radius:var(--btn-r);font-size:15.5px;font-weight:700;cursor:pointer;border:1.5px solid transparent;transition:transform .2s var(--ease),filter .2s,background .2s,color .2s}
.btn-main{background:var(--accent);color:var(--accent-ink)}
.btn-main:hover{transform:translateY(-2px);filter:brightness(1.06)}
.btn-line{border-color:var(--ink);color:var(--ink);background:transparent}
.btn-line:hover{background:var(--ink);color:var(--bg)}
html[data-style="sport"] .btn,html[data-style="mode"] .btn{text-transform:uppercase;letter-spacing:.06em;font-size:14px}
.btn svg{width:17px;height:17px}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}

/* annonce + en-tête */
.announce{background:var(--ink);color:var(--bg);font-size:12.5px;font-weight:600;text-align:center;padding:9px 16px}
html[data-style="sport"] .announce,html[data-style="tech"] .announce{background:var(--accent);color:var(--accent-ink)}
.head{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 86%,transparent);backdrop-filter:saturate(1.4) blur(12px);-webkit-backdrop-filter:saturate(1.4) blur(12px);border-bottom:1px solid transparent;transition:border-color .3s}
.head.is-stuck{border-bottom-color:var(--line)}
.head .wrap{display:flex;align-items:center;justify-content:space-between;height:68px;gap:16px}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--fh);font-size:21px;font-weight:var(--hw);text-transform:var(--ht);letter-spacing:-.01em}
.brand img{width:34px;height:34px;border-radius:50%;object-fit:cover}
.brand .logo-wide{width:auto;height:40px;border-radius:0;object-fit:contain}
.brand.logo-pill{background:#fff;padding:4px 12px;border-radius:12px}
@media (max-width:899px){.brand .logo-wide{height:34px}}
.head-nav{display:flex;gap:28px;font-size:14px;font-weight:600;color:var(--muted)}
.head-nav a:hover{color:var(--ink)}
.head .btn{min-height:44px;padding:0 20px;font-size:14px}

/* ── HERO ── */
.hero{position:relative;padding:clamp(22px,4vw,56px) 0 clamp(40px,6vw,80px);overflow:hidden}
.hero-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:clamp(26px,5vw,64px);align-items:center}
.hero-copy{display:flex;flex-direction:column;gap:20px;position:relative;z-index:2}
.hero h1{font-size:clamp(44px,6.4vw,88px)}
.hero h1 .ln{display:block}
.hero-sub{color:var(--muted);font-size:clamp(16px,1.5vw,18.5px);max-width:500px}
.price-row{display:flex;align-items:baseline;flex-wrap:wrap;gap:6px 14px}
.price-new{font-family:var(--fh);font-size:clamp(32px,3.4vw,44px);font-weight:var(--hw);letter-spacing:-.02em;line-height:1}
.price-new small{font-family:var(--fb);font-size:14px;font-weight:700;margin-left:5px;letter-spacing:0}
.price-old{color:var(--muted);text-decoration:line-through;font-size:16px}
.badge{display:inline-block;background:var(--accent);color:var(--accent-ink);font-size:12.5px;font-weight:800;padding:5px 11px;border-radius:999px}
.hero-actions{display:flex;flex-wrap:wrap;align-items:center;gap:14px 22px}
.hero-note{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:600;color:var(--muted)}
.hero-media{position:relative}
.h-stage{position:relative}
.h-main{position:relative;aspect-ratio:1/1;border-radius:calc(var(--r) + 8px);overflow:hidden;background:var(--pale)}
.h-main img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .4s}
.h-main img.fade{opacity:0}
.h-thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:12px}
.h-thumbs button{aspect-ratio:1;border-radius:calc(var(--r) * .6);overflow:hidden;border:2px solid transparent;background:var(--surface);cursor:pointer;padding:0;opacity:.65;transition:opacity .2s,border-color .2s}
.h-thumbs button[aria-current="true"]{opacity:1;border-color:var(--accent)}
.h-thumbs img{width:100%;height:100%;object-fit:cover}
.chip{position:absolute;z-index:3;display:flex;align-items:center;gap:10px;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:14px;padding:9px 14px 9px 9px;box-shadow:var(--shadow);font-size:13px;line-height:1.25;animation:bob 5s ease-in-out infinite}
.chip .ico{width:34px;height:34px}
.chip b{display:block;font-size:14px}
.chip span{color:var(--muted)}
.chip.c1{left:-14px;top:12%}
.chip.c2{right:-14px;bottom:14%;animation-delay:-2.5s}
@keyframes bob{50%{transform:translateY(-9px)}}
/* glow tech/sport */
html[data-style="tech"] .hero::before{content:'';position:absolute;right:-10%;top:-20%;width:60%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--accent) 28%,transparent),transparent 65%);pointer-events:none}
html[data-style="tech"] .hero::after{content:'';position:absolute;inset:0;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:56px 56px;mask-image:radial-gradient(ellipse at 70% 30%,#000 10%,transparent 65%);-webkit-mask-image:radial-gradient(ellipse at 70% 30%,#000 10%,transparent 65%);pointer-events:none;opacity:.6}
html[data-style="beaute"] .h-main{border-radius:48% 48% var(--r) var(--r)}
html[data-style="enfants"] .h-main{border-radius:42% 58% 55% 45% / 45% 42% 58% 55%}
html[data-style="maison"] .h-main{border-radius:var(--r) 120px var(--r) var(--r)}
/* variantes de hero */
html[data-hero="centered"] .hero-grid{grid-template-columns:1fr;text-align:center;justify-items:center}
html[data-hero="centered"] .hero-copy{align-items:center}
html[data-hero="centered"] .hero-sub{margin:0 auto}
html[data-hero="centered"] .hero-media{width:min(760px,100%)}
html[data-hero="centered"] .h-main{aspect-ratio:16/10}
html[data-hero="centered"] .pill{align-self:center}
html[data-hero="overlay"] .hero{padding:0}
html[data-hero="overlay"] .hero-grid{display:block;position:relative;max-width:none;padding:0}
html[data-hero="overlay"] .hero-media,html[data-hero="overlay"] .h-stage{position:absolute;inset:0}
html[data-hero="overlay"] .h-main{position:absolute;inset:0;aspect-ratio:auto;border-radius:0}
html[data-hero="overlay"] .h-main::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,color-mix(in srgb,var(--bg) 92%,transparent) 0%,color-mix(in srgb,var(--bg) 55%,transparent) 50%,transparent 80%)}
html[data-hero="overlay"] .h-thumbs,html[data-hero="overlay"] .chip{display:none}
html[data-hero="overlay"] .hero-copy{max-width:var(--wrap);margin:0 auto;padding:clamp(70px,12vw,150px) var(--gutter);min-height:min(88vh,820px);justify-content:center}
html[data-hero="overlay"] .hero-copy>*{max-width:560px}

/* entrée animée du hero */
.in-hero{opacity:0;transform:translateY(24px);animation:heroIn .9s var(--ease) forwards}
.in-hero:nth-child(2){animation-delay:.08s}.in-hero:nth-child(3){animation-delay:.16s}.in-hero:nth-child(4){animation-delay:.24s}.in-hero:nth-child(5){animation-delay:.32s}.in-hero:nth-child(6){animation-delay:.4s}
@keyframes heroIn{to{opacity:1;transform:none}}

/* ── RÉASSURANCE ── */
.trust{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--surface)}
.trust ul{display:grid;grid-template-columns:repeat(var(--n,4),1fr)}
.trust li{display:flex;gap:12px;align-items:center;padding:20px 18px;border-left:1px solid var(--line)}
.trust li:first-child{border-left:0}
.trust .ico{width:42px;height:42px}
.trust b{display:block;font-size:14.5px;line-height:1.25}
.trust span{display:block;font-size:12.5px;color:var(--muted);line-height:1.35}

/* ── CHIFFRES ── */
.stats{display:grid;grid-template-columns:repeat(var(--n,4),1fr);gap:14px}
.stat{padding:26px 20px;text-align:center}
.stat b{display:block;font-family:var(--fh);font-weight:var(--hw);font-size:clamp(34px,4vw,52px);line-height:1;color:var(--accent);letter-spacing:-.02em}
html[data-style="sante"] .stat b,html[data-style="maison"] .stat b,html[data-style="mode"] .stat b,html[data-style="beaute"] .stat b{color:var(--ink)}
.stat span{display:block;margin-top:8px;font-size:14px;color:var(--muted)}

/* ── BANDEAU DÉFILANT ── */
.marquee{background:var(--accent);color:var(--accent-ink);overflow:hidden;padding:15px 0}
html[data-style="mode"] .marquee,html[data-style="maison"] .marquee,html[data-style="beaute"] .marquee{background:var(--ink);color:var(--bg)}
.marquee .track{display:flex;width:max-content;animation:marq 30s linear infinite}
.marquee ul{display:flex;flex:none}
.marquee li{display:flex;align-items:center;gap:22px;padding-right:22px;font-family:var(--fh);font-size:clamp(19px,2.2vw,28px);font-weight:var(--hw);text-transform:var(--ht);white-space:nowrap}
.marquee li::after{content:'✦';font-size:.7em;opacity:.7}
@keyframes marq{to{transform:translateX(-50%)}}

/* ── PROBLÈME → SOLUTION ── */
.ps{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.ps-box{padding:clamp(24px,3.5vw,40px);display:flex;flex-direction:column;gap:14px}
.ps-box.bad{background:var(--surface)}
.ps-box.good{background:var(--ink);color:var(--bg);border-color:var(--ink)}
html[data-style="tech"] .ps-box.good,html[data-style="sport"] .ps-box.good{background:var(--accent);color:var(--accent-ink)}
.ps-box h3{font-size:clamp(24px,2.6vw,32px)}
.ps-box li{display:flex;gap:10px;align-items:flex-start;font-size:15.5px}
.ps-box li::before{content:'✕';flex:none;width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-size:11px;font-weight:800;background:color-mix(in srgb,#e5484d 14%,transparent);color:#e5484d;margin-top:1px}
.ps-box.good li::before{content:'✓';background:color-mix(in srgb,currentColor 16%,transparent);color:inherit}
.ps-box p{opacity:.8}
.ps-img{border-radius:calc(var(--r) * .7);overflow:hidden;aspect-ratio:16/10;margin-top:6px}
.ps-img img{width:100%;height:100%;object-fit:cover}

/* ── BÉNÉFICES ── */
.benefits{display:grid;grid-template-columns:repeat(var(--cols,4),1fr);gap:16px}
.benefit{padding:28px 22px;display:flex;flex-direction:column;gap:12px;transition:transform .35s var(--ease),border-color .35s}
.benefit:hover{transform:translateY(-4px);border-color:var(--accent)}
.benefit h3{font-size:18px;font-weight:700;font-family:var(--fb);letter-spacing:-.01em}
.benefit p{font-size:14.5px;color:var(--muted);line-height:1.5}
html[data-style="enfants"] .benefit:nth-child(3n+2) .ico{background:color-mix(in srgb,var(--accent2) 18%,var(--surface))}

/* ── VITRINE (image / texte alternés) ── */
.showcase{display:flex;flex-direction:column;gap:clamp(48px,7vw,96px)}
.sc{display:grid;grid-template-columns:1fr 1fr;gap:clamp(26px,6vw,80px);align-items:center}
.sc:nth-child(even) .sc-media{order:2}
.sc-media{aspect-ratio:5/5.4;border-radius:var(--r);overflow:hidden;background:var(--pale)}
.sc-media img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s var(--ease)}
.sc:hover .sc-media img{transform:scale(1.03)}
.sc-copy{display:flex;flex-direction:column;gap:14px;max-width:470px}
.sc-copy h3{font-size:clamp(28px,3vw,40px)}
.sc-copy p{color:var(--muted);font-size:16.5px}
.sc-copy .btn{align-self:flex-start;margin-top:6px}

/* ── DÉMONSTRATION / ÉTAPES ── */
.demo{display:grid;grid-template-columns:repeat(var(--n,3),1fr);gap:16px;counter-reset:st}
.step{overflow:hidden;display:flex;flex-direction:column}
.step-img{aspect-ratio:4/3;background:var(--pale)}
.step-img img{width:100%;height:100%;object-fit:cover}
.step-body{padding:22px;display:flex;flex-direction:column;gap:8px}
.step-n{width:40px;height:40px;border-radius:50%;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center;font-weight:800;font-size:16px}
html[data-style="mode"] .step-n{border-radius:0}
.step h3{font-size:21px;margin-top:4px}
.step p{color:var(--muted);font-size:15px}

/* ── GALERIE ── */
.gal{display:grid;grid-template-columns:repeat(var(--cols,3),1fr);grid-auto-rows:clamp(150px,18vw,240px);gap:12px}
.gal.feature{--cols:4}
.gal figure{border-radius:var(--r);overflow:hidden;background:var(--pale)}
.gal.feature figure:first-child{grid-column:span 2;grid-row:span 2}
.gal img{width:100%;height:100%;object-fit:cover;transition:transform .9s var(--ease)}
.gal figure:hover img{transform:scale(1.05)}

/* ── AVANT / APRÈS ── */
.ba{position:relative;max-width:900px;margin:0 auto;aspect-ratio:16/10;border-radius:var(--r);overflow:hidden;user-select:none;touch-action:pan-y}
.ba img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.ba .after{clip-path:inset(0 0 0 var(--pos,50%))}
.ba .bar-h{position:absolute;top:0;bottom:0;left:var(--pos,50%);width:3px;margin-left:-1.5px;background:#fff;box-shadow:0 0 12px rgba(0,0,0,.3)}
.ba .knob{position:absolute;top:50%;left:var(--pos,50%);width:46px;height:46px;margin:-23px 0 0 -23px;border-radius:50%;background:#fff;color:#111;display:grid;place-items:center;font-weight:800;box-shadow:0 6px 18px rgba(0,0,0,.25)}
.ba .lbl{position:absolute;top:14px;background:rgba(0,0,0,.6);color:#fff;font-size:12px;font-weight:700;padding:5px 10px;border-radius:999px}
.ba .lbl.l{left:14px}.ba .lbl.r{right:14px}
.ba input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0}

/* ── CARACTÉRISTIQUES ── */
.specs-wrap{display:grid;grid-template-columns:1fr 1fr;gap:clamp(26px,6vw,80px);align-items:center}
.specs-wrap.solo{grid-template-columns:1fr;max-width:760px;margin:0 auto}
.specs-media{aspect-ratio:1;border-radius:var(--r);overflow:hidden;background:var(--pale)}
.specs-media img{width:100%;height:100%;object-fit:cover}
.specs{padding:6px 22px}
.specs li{display:flex;justify-content:space-between;gap:20px;padding:15px 0;border-bottom:1px solid var(--line);font-size:15px}
.specs li:last-child{border-bottom:0}
.specs li span{color:var(--muted)}
.specs li b{text-align:right}

/* ── COMPARAISON ── */
.cmp-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
.cmp{width:100%;min-width:520px;border-collapse:separate;border-spacing:0;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;font-size:15px}
.cmp th,.cmp td{padding:15px 18px;text-align:center;border-bottom:1px solid var(--line)}
.cmp tr:last-child td{border-bottom:0}
.cmp th{font-family:var(--fh);font-weight:var(--hw);font-size:17px;text-transform:var(--ht)}
.cmp td:first-child,.cmp th:first-child{text-align:left;color:var(--muted)}
.cmp .hl{background:var(--soft)}
.cmp .yes{color:var(--accent);font-weight:800}
html[data-style="sante"] .cmp .yes,html[data-style="maison"] .cmp .yes,html[data-style="beaute"] .cmp .yes,html[data-style="mode"] .cmp .yes{color:var(--ink)}

/* ── INCLUS ── */
.incl{display:grid;grid-template-columns:repeat(var(--n,4),1fr);gap:14px}
.incl figure{overflow:hidden}
.incl .im{aspect-ratio:1;background:var(--pale)}
.incl img{width:100%;height:100%;object-fit:cover}
.incl figcaption{padding:14px;font-size:14.5px;font-weight:700;text-align:center}
.incl .noimg figcaption{display:flex;flex-direction:column;align-items:center;gap:10px;padding:24px 14px}

/* ── AVIS (vrais avis uniquement) ── */
.reviews{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px}
.review{padding:24px;display:flex;flex-direction:column;gap:12px}
.review p{font-size:15.5px}
.review cite{font-style:normal;font-size:13px;font-weight:700}
.stars{color:#f2a51a;letter-spacing:2px}

/* ── OFFRE ── */
.offer{display:grid;grid-template-columns:1.05fr 1fr;overflow:hidden;border-radius:calc(var(--r) + 6px)}
.offer.solo{grid-template-columns:1fr;max-width:640px;margin:0 auto}
.offer-media{background:var(--pale);min-height:100%}
.offer-media img{width:100%;height:100%;object-fit:cover}
.offer-body{padding:clamp(26px,4.5vw,52px);display:flex;flex-direction:column;gap:16px}
.offer-body h2{font-size:clamp(28px,3.2vw,40px)}
.offer-body>p{color:var(--muted)}
.offer-list li{display:flex;gap:11px;align-items:center;padding:6px 0;font-size:15px;font-weight:500}
.offer-price{display:flex;align-items:baseline;flex-wrap:wrap;gap:6px 14px;padding:16px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.offer-terms{display:grid;gap:8px;font-size:14px;color:var(--muted)}
.offer-terms b{color:var(--ink)}
.offer-body .btn{width:100%}
.countdown{display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:13px;font-weight:700;color:var(--muted)}
.countdown .cd{display:flex;gap:6px}
.countdown .cd span{min-width:46px;padding:8px 6px;border-radius:10px;background:var(--ink);color:var(--bg);text-align:center;font-family:var(--fh);font-size:18px;line-height:1}
.countdown .cd small{display:block;font-family:var(--fb);font-size:10px;font-weight:600;opacity:.7;margin-top:3px}

/* ── FAQ ── */
.faq{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:10px}
.faq details{padding:0 20px}
.faq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:19px 0;font-size:16px;font-weight:700}
.faq summary::-webkit-details-marker{display:none}
.faq summary i{flex:none;position:relative;width:28px;height:28px;border-radius:50%;background:var(--soft)}
.faq summary i::before,.faq summary i::after{content:'';position:absolute;left:8px;top:13.25px;width:12px;height:1.5px;background:var(--ink);transition:transform .3s var(--ease)}
.faq summary i::after{transform:rotate(90deg)}
.faq details[open] summary i::after{transform:rotate(0)}
.faq .a{padding:0 0 20px;color:var(--muted)}

/* ── CTA FINAL ── */
.cta{position:relative;overflow:hidden;border-radius:calc(var(--r) + 8px);padding:clamp(30px,5vw,64px);display:grid;grid-template-columns:1.3fr 1fr;gap:clamp(24px,4vw,48px);align-items:center;background:var(--ink);color:var(--bg)}
html[data-style="tech"] .cta,html[data-style="sport"] .cta{background:var(--surface);color:var(--ink);border:1px solid var(--line)}
.cta::after{content:'';position:absolute;right:-12%;top:-45%;width:55%;aspect-ratio:1;border-radius:50%;background:color-mix(in srgb,var(--accent) 22%,transparent);filter:blur(10px);pointer-events:none}
.cta h2{font-size:clamp(32px,4.4vw,58px);position:relative;z-index:1}
.cta p{opacity:.75;margin-top:14px;max-width:460px;position:relative;z-index:1}
.cta-card{position:relative;z-index:1;border:1px solid color-mix(in srgb,currentColor 18%,transparent);border-radius:var(--r);padding:clamp(22px,3vw,32px);display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center;background:color-mix(in srgb,currentColor 5%,transparent)}
.cta-card .price-old{color:inherit;opacity:.55}
.cta-card .note{font-size:13.5px;opacity:.8}
.cta-card .btn{width:100%;margin-top:6px;animation:glow 2.8s ease-in-out infinite}
@keyframes glow{0%,100%{box-shadow:0 0 0 0 color-mix(in srgb,var(--accent) 55%,transparent)}50%{box-shadow:0 0 0 10px transparent}}

.foot{border-top:1px solid var(--line);padding:30px 0 calc(30px + 76px)}
.foot .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:14px;font-size:13px;color:var(--muted)}
.foot .brand{font-size:18px;color:var(--ink)}

/* barre fixe mobile */
.bar{position:fixed;left:0;right:0;bottom:0;z-index:60;background:color-mix(in srgb,var(--surface) 95%,transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-top:1px solid var(--line);padding:10px var(--gutter) max(10px,env(safe-area-inset-bottom));display:flex;align-items:center;gap:14px;transform:translateY(110%);transition:transform .4s var(--ease)}
.bar.is-on{transform:none}
.bar-price{display:flex;flex-direction:column;line-height:1.15}
.bar-price b{font-size:17px}
.bar-price s{font-size:12px;color:var(--muted)}
.bar .btn{flex:1;min-height:52px;padding:0 18px;white-space:nowrap;font-size:15px}
@media (max-width:560px){.bar-price{display:none}}
@media (min-width:900px){.bar{display:none}.foot{padding-bottom:30px}}

/* apparition au défilement */
.rv{opacity:0;transform:translateY(22px);transition:opacity .85s var(--ease),transform .85s var(--ease)}
.rv.in{opacity:1;transform:none}
.no-js .rv,.no-js .in-hero{opacity:1;transform:none;animation:none}
.benefits .rv:nth-child(2),.demo .rv:nth-child(2),.incl .rv:nth-child(2),.stats .rv:nth-child(2){transition-delay:.08s}
.benefits .rv:nth-child(3),.demo .rv:nth-child(3),.incl .rv:nth-child(3),.stats .rv:nth-child(3){transition-delay:.16s}
.benefits .rv:nth-child(4),.demo .rv:nth-child(4),.incl .rv:nth-child(4),.stats .rv:nth-child(4){transition-delay:.24s}
@media (prefers-reduced-motion:reduce){
  .rv,.in-hero{opacity:1;transform:none;transition:none;animation:none}
  .chip,.marquee .track,.cta-card .btn{animation:none}
  html{scroll-behavior:auto}
}

/* responsive */
@media (max-width:899px){
  .head-nav{display:none}
  .head .wrap{height:60px}
  .hero-grid{grid-template-columns:1fr}
  .hero-media{order:-1}
  html[data-hero="centered"] .hero-media{order:0}
  html[data-hero="overlay"] .hero-copy{min-height:auto;padding-top:clamp(220px,62vw,340px);padding-bottom:40px}
  html[data-hero="overlay"] .h-main::after{background:linear-gradient(180deg,transparent 0%,color-mix(in srgb,var(--bg) 40%,transparent) 30%,var(--bg) 62%)}
  .h-main{aspect-ratio:5/4.3}
  .chip.c1{left:8px}.chip.c2{right:8px}
  .chip{font-size:12px;padding:7px 11px 7px 7px}.chip .ico{width:30px;height:30px}
  .hero-actions .btn{width:100%}
  .trust ul,.stats{grid-template-columns:1fr 1fr}
  .trust li{border-left:0;border-top:1px solid var(--line);padding:14px 12px}
  .trust li:nth-child(-n+2){border-top:0}
  .trust li:nth-child(even){border-left:1px solid var(--line)}
  .benefits,.incl{grid-template-columns:1fr 1fr;gap:12px}
  .benefit{padding:20px 16px}
  .ps,.sc,.specs-wrap,.offer,.cta,.demo{grid-template-columns:1fr}
  .sc:nth-child(even) .sc-media{order:0}
  .sc-media{aspect-ratio:4/4.2}
  .gal,.gal.feature{grid-template-columns:1fr 1fr;grid-auto-rows:150px}
  .gal.feature figure:first-child{grid-column:span 2;grid-row:span 1}
  .gal.odd figure:last-child{grid-column:span 2}
  .offer-media{aspect-ratio:4/3}
}
@media (max-width:380px){.benefits{grid-template-columns:1fr}}

/* ═══════════ COUCHE DYNAMIQUE (surtout mobile) ═══════════ */
.progress{position:fixed;left:0;top:0;height:3px;width:100%;z-index:90;background:var(--accent);transform-origin:0 50%;transform:scaleX(0);pointer-events:none}
/* galerie du hero : défilement auto + glisser */
.h-stage{touch-action:pan-y}
.h-thumbs button{position:relative}
.h-thumbs.auto button[aria-current="true"]::after{content:'';position:absolute;left:0;bottom:0;height:3px;width:100%;background:var(--accent);transform-origin:0 50%;animation:thumbBar var(--auto,4s) linear forwards}
@keyframes thumbBar{from{transform:scaleX(0)}to{transform:scaleX(1)}}
.h-main img.slide-l{animation:slideL .45s var(--ease)}
.h-main img.slide-r{animation:slideR .45s var(--ease)}
@keyframes slideL{from{transform:translateX(8%);opacity:.2}to{transform:none;opacity:1}}
@keyframes slideR{from{transform:translateX(-8%);opacity:.2}to{transform:none;opacity:1}}
/* balayage laser (style tech) */
html[data-style="tech"] .h-main::before{content:'';position:absolute;left:0;right:0;top:0;height:2px;z-index:2;background:linear-gradient(90deg,transparent,var(--accent),transparent);box-shadow:0 0 16px 2px var(--accent);opacity:.8;animation:scan 3.4s ease-in-out infinite;pointer-events:none}
@keyframes scan{0%{top:4%}50%{top:94%}100%{top:4%}}
/* boutons vivants */
.btn:active{transform:scale(.97)}
#heroOrder,.bar .btn,.cta-card .btn{position:relative;overflow:hidden}
#heroOrder::after,.bar .btn::after,.cta-card .btn::after{content:'';position:absolute;top:0;left:-70%;width:45%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.5),transparent);transform:skewX(-20deg);animation:shine 3.8s ease-in-out infinite;pointer-events:none}
@keyframes shine{0%,55%{left:-70%}100%{left:130%}}
.hero .badge{display:inline-block;animation:pop 2.6s ease-in-out infinite}
@keyframes pop{0%,100%{transform:scale(1)}50%{transform:scale(1.1)}}
/* photos qui se dévoilent */
.sc-media.rv img,.specs-media.rv img,.ps-img img{transform:scale(1.14);transition:transform 1.5s var(--ease)}
.sc-media.rv.in img,.specs-media.rv.in img,.ps-box.in .ps-img img{transform:scale(1)}
/* points des carrousels */
.cdots{display:none}
@media (max-width:899px){
  /* cartes en carrousel glissable */
  .benefits,.demo,.incl,.reviews{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:12px;margin:0 calc(var(--gutter) * -1);padding:4px var(--gutter) 16px;scroll-padding:0 var(--gutter);-webkit-overflow-scrolling:touch;scrollbar-width:none}
  .benefits::-webkit-scrollbar,.demo::-webkit-scrollbar,.incl::-webkit-scrollbar,.reviews::-webkit-scrollbar{display:none}
  .benefits>*,.demo>*,.reviews>*{flex:0 0 80%;scroll-snap-align:start}
  .incl>*{flex:0 0 64%;scroll-snap-align:start}
  .benefit{padding:24px 20px}
  .cdots{display:flex;justify-content:center;gap:7px;margin-top:4px}
  .cdots button{width:7px;height:7px;border-radius:999px;border:0;padding:0;background:color-mix(in srgb,var(--ink) 22%,transparent);transition:width .3s var(--ease),background .3s}
  .cdots button[aria-current="true"]{width:22px;background:var(--accent)}
  .swipe-hint{transition:opacity .4s;display:flex;align-items:center;justify-content:center;gap:8px;font-size:12.5px;font-weight:600;color:var(--muted);margin:-6px 0 12px}
  .swipe-hint i{display:inline-block;animation:hint 1.6s ease-in-out infinite;font-style:normal}
  @keyframes hint{0%,100%{transform:translateX(0)}50%{transform:translateX(6px)}}
  .hero h1{font-size:clamp(40px,11.5vw,56px)}
}
@media (min-width:900px){.swipe-hint{display:none}}
@media (prefers-reduced-motion:reduce){
  .h-thumbs.auto button::after,html[data-style="tech"] .h-main::before,#heroOrder::after,.bar .btn::after,.cta-card .btn::after,.hero .badge,.swipe-hint i{animation:none}
  .h-main img.slide-l,.h-main img.slide-r{animation:none}
  .sc-media.rv img,.specs-media.rv img,.ps-img img{transform:none;transition:none}
}

/* ── boutons du haut : pulsation ── */
#heroOrder,.head .btn-main{animation:ctaPulse 2.2s ease-out infinite}
@keyframes ctaPulse{
  0%{transform:scale(1);box-shadow:0 0 0 0 color-mix(in srgb,var(--accent) 65%,transparent)}
  35%{transform:scale(1.045)}
  70%{transform:scale(1);box-shadow:0 0 0 16px color-mix(in srgb,var(--accent) 0%,transparent)}
  100%{transform:scale(1);box-shadow:0 0 0 0 color-mix(in srgb,var(--accent) 0%,transparent)}
}
#heroOrder:active,.head .btn-main:active{animation:none;transform:scale(.97)}

/* ── bandeau des garanties : icônes bien centrées + animées ── */
.trust .ico{display:grid;place-items:center;position:relative;flex:none}
.trust .ico svg{display:block;width:52%;height:52%}
.trust .ico::after{content:'';position:absolute;inset:0;border-radius:50%;border:1.5px solid var(--accent);opacity:0;animation:ring 3.2s ease-out infinite}
.trust li:nth-child(2) .ico::after{animation-delay:.8s}
.trust li:nth-child(3) .ico::after{animation-delay:1.6s}
.trust li:nth-child(4) .ico::after{animation-delay:2.4s}
@keyframes ring{0%{transform:scale(1);opacity:.7}70%,100%{transform:scale(1.55);opacity:0}}
.trust [data-icon="truck"] svg{animation:drive 2.6s ease-in-out infinite}
.trust [data-icon="phone"] svg{animation:ringing 2.8s ease-in-out infinite;transform-origin:50% 60%}
.trust [data-icon="cash"] svg{animation:flip 3.6s ease-in-out infinite}
.trust [data-icon="battery"] svg,.trust [data-icon="bolt"] svg{animation:charge 2s ease-in-out infinite}
.trust [data-icon="shield"] svg,.trust [data-icon="star"] svg,.trust [data-icon="clock"] svg,.trust [data-icon="box"] svg{animation:bobIco 2.8s ease-in-out infinite}
@keyframes drive{0%,100%{transform:translateX(-2px)}50%{transform:translateX(3px)}}
@keyframes ringing{0%,60%,100%{transform:rotate(0)}64%{transform:rotate(-14deg)}68%{transform:rotate(12deg)}72%{transform:rotate(-10deg)}76%{transform:rotate(8deg)}80%{transform:rotate(0)}}
@keyframes flip{0%,70%,100%{transform:rotateY(0)}85%{transform:rotateY(180deg)}}
@keyframes charge{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.55;transform:scale(.92)}}
@keyframes bobIco{0%,100%{transform:translateY(0)}50%{transform:translateY(-2px)}}
.trust li.rv{transform:translateY(14px) scale(.96)}
.trust li.rv.in{transform:none}
.trust li:nth-child(2).rv{transition-delay:.08s}.trust li:nth-child(3).rv{transition-delay:.16s}.trust li:nth-child(4).rv{transition-delay:.24s}
@media (max-width:899px){
  .trust .wrap{padding:0 12px}
  .trust ul{gap:10px;padding:16px 0}
  .trust li,.trust li:nth-child(even),.trust li:nth-child(-n+2){flex-direction:column;align-items:center;justify-content:flex-start;text-align:center;gap:10px;padding:16px 10px 14px;border:1px solid var(--line);border-radius:calc(var(--r) * .8);background:color-mix(in srgb,var(--accent) 4%,var(--bg))}
  .trust{border-top:0;border-bottom:0;background:transparent}
  .trust .ico{width:50px;height:50px}
  .trust b{font-size:14px}
  .trust span{font-size:12.5px}
}
@media (prefers-reduced-motion:reduce){
  #heroOrder,.head .btn-main,.trust .ico::after,.trust .ico svg{animation:none}
}

/* ── écran « réservé aux adultes » (option age_gate) ── */
html.no-scan .h-main::before{display:none}
.announce.scroll{padding:0;overflow:hidden;white-space:nowrap}
.ann-track{display:flex;width:max-content;animation:annRun 28s linear infinite}
.ann-track>div{display:flex;align-items:center;flex:none}
.ann-track span{padding:10px 0;font-size:13px;letter-spacing:.01em}
.ann-track i{font-style:normal;opacity:.75;margin:0 18px;font-size:11px}
.announce.scroll:hover .ann-track{animation-play-state:paused}
@keyframes annRun{to{transform:translateX(-50%)}}
@media (prefers-reduced-motion:reduce){.ann-track{animation-duration:80s}}
.vid{position:relative;margin:0 auto;max-width:960px;border-radius:22px;overflow:hidden;background:#000;box-shadow:0 24px 60px -24px rgba(0,0,0,.55)}
.vid video{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;background:#000}
.vid-btn{position:absolute;left:50%;top:50%;width:64px;height:64px;margin:-32px 0 0 -32px;border:0;border-radius:50%;background:var(--accent);color:var(--accent-ink,#fff);display:grid;place-items:center;cursor:pointer;box-shadow:0 0 0 10px color-mix(in srgb,var(--accent) 25%,transparent);transition:opacity .3s,transform .3s}
.vid-btn svg{width:22px;height:22px;fill:currentColor;margin-left:3px}
.vid.playing .vid-btn{opacity:0;transform:scale(.8);pointer-events:none}
.vid figcaption{position:absolute;left:12px;bottom:12px;padding:6px 12px;border-radius:999px;background:rgba(0,0,0,.6);color:#fff;font-size:13px;font-weight:600}
.vid-cta{text-align:center;margin-top:22px}
@media(max-width:640px){.vid{border-radius:16px}}
.agegate{position:fixed;inset:0;z-index:300;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(8,8,10,.94);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px)}
html.age-ok .agegate,.no-js .agegate{display:none}
html.age-lock,html.age-lock body{overflow:hidden}
.ag-box{width:min(440px,100%);background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:calc(var(--r) + 6px);padding:30px 24px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px;box-shadow:0 40px 80px -40px rgba(0,0,0,.8)}
.ag-badge{width:68px;height:68px;border-radius:50%;display:grid;place-items:center;background:var(--accent);color:var(--accent-ink);font-weight:800;font-size:22px}
.ag-box h2{font-family:var(--fh);font-size:24px;line-height:1.2}
.ag-box p{color:var(--muted);font-size:15px}
.ag-box .btn{width:100%}
.ag-exit{font-size:14px;font-weight:600;color:var(--muted);text-decoration:underline}

/* ── panneau de commande (formulaire COD de l'app) ── */
html.order-open,html.order-open body{overflow:hidden}
.order-panel{position:fixed;inset:0;z-index:130;visibility:hidden;pointer-events:none;display:flex;align-items:flex-end;justify-content:center}
.order-panel.is-open{visibility:visible;pointer-events:auto}
.order-backdrop{position:absolute;inset:0;background:rgba(15,15,15,.55);opacity:0;transition:opacity .35s ease}
.order-panel.is-open .order-backdrop{opacity:1}
/* jamais de transform sur la feuille ouverte : sinon les pop-ups de l'app COD disparaissent */
.order-sheet{position:relative;z-index:1;width:min(620px,100%);max-height:92vh;max-height:92dvh;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;background:#fff;color:#16171a;border-radius:24px 24px 0 0;padding:22px clamp(16px,4vw,30px) max(24px,env(safe-area-inset-bottom));outline:none;text-align:left;font-family:var(--fb)}
.order-panel.is-open .order-sheet{animation:sheetUp .42s cubic-bezier(.22,1,.36,1) backwards}
@keyframes sheetUp{from{transform:translateY(60px);opacity:0}to{transform:none;opacity:1}}
@media (min-width:760px){.order-panel{align-items:center}.order-sheet{border-radius:24px;max-height:88vh}}
.order-close{position:sticky;top:0;float:right;margin:-8px -6px 0 0;width:40px;height:40px;border:0;border-radius:50%;background:#f1f1ef;color:#16171a;font-size:24px;line-height:1;cursor:pointer;z-index:2}
.order-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;padding:2px 44px 16px 0;margin-bottom:12px;border-bottom:1px solid #eee}
.order-title{flex-basis:100%;font-size:21px;font-weight:800;line-height:1.2;margin-bottom:4px}
.order-old{text-decoration:line-through;color:#7a7a7a;font-size:14px}
.order-new{font-size:22px;font-weight:800}
.order-note{flex-basis:100%;font-size:12.5px;font-weight:700;color:#2a7a3b}
.cod-box{overflow:visible}
.cod-box *{color:inherit}
.cod-box .mm-native label{display:block;font-size:14px;margin:0 0 6px}
.cod-box .mm-native select{width:100%;font:inherit;padding:12px;border:1px solid #ddd;border-radius:12px;background:#fff;margin-bottom:14px}
.cod-box .mm-native .mm-title{font-size:17px;font-weight:700;margin-bottom:14px}
.cod-box .mm-native .btn-order{width:100%;min-height:54px;border:0;border-radius:999px;background:#16171a;color:#fff;font-size:16px;font-weight:700;cursor:pointer}
  </style>
