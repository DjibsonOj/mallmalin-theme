      <div class="wrap">
<div class="sec-head rv"><span class="kicker">Questions fréquentes</span><h2 class="h h2">Vos questions</h2></div><div class="faq rv"><details class="card"><summary>Comment se passe le paiement ?<i aria-hidden="true"></i></summary><p class="a">Vous ne payez rien en ligne. Vous remplissez le formulaire, nous vous appelons pour confirmer, puis vous payez à la livraison, quand le colis vous est remis.</p></details><details class="card"><summary>Livrez-vous dans mon pays ?<i aria-hidden="true"></i></summary><p class="a">Nous livrons dans plusieurs pays. Indiquez votre pays et votre ville dans le formulaire : nous vous appelons pour confirmer la livraison.</p></details><details class="card"><summary>Comment le recharger ?<i aria-hidden="true"></i></summary><p class="a">Il fonctionne sur batterie rechargeable : branchez-le avec le câble de charge fourni dans le colis.</p></details><details class="card"><summary>Sur quelles surfaces l'aimant tient-il ?<i aria-hidden="true"></i></summary><p class="a">L'aimant tient sur les surfaces métalliques magnétiques (acier, fer). Sur le bois, le carrelage ou le plastique, il suffit de le poser ou de le tenir contre la surface.</p></details><details class="card"><summary>Peut-il mesurer une pente en pourcentage ?<i aria-hidden="true"></i></summary><p class="a">Oui. La touche Tilt% bascule l'affichage entre l'angle en degrés et la pente en %.</p></details><details class="card"><summary>À quoi servent les touches ZERO et HOLD ?<i aria-hidden="true"></i></summary><p class="a">ZERO remet l'affichage à 0 sur une surface de votre choix pour mesurer par rapport à elle. HOLD fige la valeur affichée pour la lire tranquillement.</p></details><details class="card"><summary>Que contient le colis ?<i aria-hidden="true"></i></summary><p class="a">L'inclinomètre numérique laser, sa housse de rangement et le câble de charge.</p></details></div>
      </div>
    </section>

    <section style="padding:0 0 clamp(40px,6vw,72px)" id="cta"><div class="wrap"><div class="cta rv"><div><h2 class="h">Mesurez juste, <em>dès aujourd'hui.</em></h2><p>Pas de paiement en ligne, pas de carte bancaire : vous payez à la livraison.</p></div><div class="cta-card"><div class="price-row" style="justify-content:center"><span class="price-new">{{ mm_new }}<small>{{ mm_cur }}</small></span><span class="price-old">{{ mm_old }} {{ mm_cur }}</span></div><span class="note">Housse et câble de charge inclus</span><a class="btn btn-main" href="#commander" data-order id="finalOrder">Commander maintenant<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a></div></div></div></section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <span class="brand">Afribazaar</span>
      <span>Paiement à la livraison · Appel de confirmation</span>
      <span>© {{ 'now' | date: '%Y' }} Afribazaar</span>
    </div>
  </footer>

  <div class="bar" id="bar">
    <div class="bar-price"><b>{{ mm_new }} {{ mm_cur }}</b><s>{{ mm_old }} {{ mm_cur }}</s></div>
    <a class="btn btn-main" href="#commander" data-order>Acheter maintenant · {{ mm_new }} {{ mm_cur }}</a>
  </div>

  <div class="order-panel" id="orderPanel" aria-hidden="true">
    <div class="order-backdrop" data-close></div>
    <div class="order-sheet" id="commander" role="dialog" aria-modal="true" aria-label="Commander : Inclinomètre numérique laser magnétique rechargeable" tabindex="-1">
      <button type="button" class="order-close" data-close aria-label="Fermer">&times;</button>
      <div class="order-head">
        <span class="order-title">Inclinomètre numérique laser magnétique rechargeable</span>
        <span class="order-new">{{ mm_new }} {{ mm_cur }}</span>
        <span class="order-old">{{ mm_old }} {{ mm_cur }}</span>
        <span class="order-note">Paiement à la livraison — nous vous appelons pour confirmer</span>
      </div>
      <div class="cod-box">
        {{ content_for_layout }}
      </div>
    </div>
  </div>

  <script>
(function(){
  var d=document, root=d.documentElement, reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
  d.body.classList.remove('no-js');

  /* apparitions */
  var rv=[].slice.call(d.querySelectorAll('.rv'));
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{rootMargin:'0px 0px -8% 0px',threshold:.06});
    rv.forEach(function(el){io.observe(el);});
  } else rv.forEach(function(el){el.classList.add('in');});

  /* galerie du hero */
  var main=d.getElementById('hMain');
  [].forEach.call(d.querySelectorAll('.h-thumbs button'),function(b,i,all){
    b.addEventListener('click',function(){
      if(b.getAttribute('aria-current')==='true') return;
      [].forEach.call(all,function(x){x.setAttribute('aria-current','false');});
      b.setAttribute('aria-current','true'); main.classList.add('fade');
      setTimeout(function(){main.src=b.getAttribute('data-src');main.alt=b.getAttribute('data-alt');setTimeout(function(){main.classList.remove('fade');},120);},200);
    });
  });

  /* compteurs */
  function count(el){
    var raw=el.getAttribute('data-count'), to=parseFloat(raw.replace(',','.')), dec=(raw.split(/[.,]/)[1]||'').length, suf=el.getAttribute('data-suffix')||'', t0=null;
    function step(t){ if(!t0)t0=t; var k=Math.min(1,(t-t0)/1400), v=to*(1-Math.pow(1-k,3)); el.textContent=v.toFixed(dec).replace('.',',')+suf; if(k<1) requestAnimationFrame(step); }
    if(!reduce) requestAnimationFrame(step);
  }
  if('IntersectionObserver' in window){
    var ic=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){count(e.target);ic.unobserve(e.target);}});},{threshold:.6});
    [].forEach.call(d.querySelectorAll('[data-count]'),function(c){ic.observe(c);});
  }

  /* avant / après */
  [].forEach.call(d.querySelectorAll('.ba'),function(ba){
    var r=ba.querySelector('input'); r.addEventListener('input',function(){ba.style.setProperty('--pos',r.value+'%');});
  });

  /* compte à rebours (uniquement avec une vraie date de fin) */
  [].forEach.call(d.querySelectorAll('[data-ends]'),function(box){
    var end=new Date(box.getAttribute('data-ends')).getTime(), cells=box.querySelectorAll('[data-u]');
    function tick(){
      var s=Math.floor((end-Date.now())/1000);
      if(isNaN(end)||s<=0){ box.hidden=true; return; }
      var v=[Math.floor(s/86400),Math.floor(s%86400/3600),Math.floor(s%3600/60),s%60];
      [].forEach.call(cells,function(c,i){c.firstChild.nodeValue=String(v[i]).padStart(2,'0');});
      setTimeout(tick,1000);
    }
    tick();
  });

  /* en-tête */
  var head=d.getElementById('head');
  function onScroll(){head.classList.toggle('is-stuck',window.scrollY>8);}
  addEventListener('scroll',onScroll,{passive:true}); onScroll();

  /* panneau de commande + barre mobile */
  var panel=d.getElementById('orderPanel'), sheet=d.getElementById('commander'), bar=d.getElementById('bar'), last=null, heroVis=true, endVis=false;
  function updateBar(){ if(bar) bar.classList.toggle('is-on', !heroVis && !endVis && !panel.classList.contains('is-open')); }
  function open(){ last=d.activeElement; panel.classList.add('is-open'); panel.setAttribute('aria-hidden','false'); root.classList.add('order-open'); updateBar(); sheet.scrollTop=0; setTimeout(function(){try{sheet.focus({preventScroll:true});}catch(e){}},60); }
  function close(){ panel.classList.remove('is-open'); panel.setAttribute('aria-hidden','true'); root.classList.remove('order-open'); updateBar(); if(last&&last.focus){try{last.focus({preventScroll:true});}catch(e){}} }
  var h=d.getElementById('heroOrder'), f=d.getElementById('finalOrder');
  if('IntersectionObserver' in window && h){
    var ob=new IntersectionObserver(function(es){es.forEach(function(e){ if(e.target===h) heroVis=e.isIntersecting||e.boundingClientRect.top>0; else endVis=e.isIntersecting; }); updateBar();},{threshold:0});
    ob.observe(h); if(f) ob.observe(f);
  } else { heroVis=false; updateBar(); }
  d.addEventListener('click',function(e){
    var t=e.target.closest&&e.target.closest('[data-order],[data-close]');
    if(!t) return; e.preventDefault(); e.stopPropagation();
    if(t.hasAttribute('data-close')) close(); else open();
  },true);
  d.addEventListener('keydown',function(e){ if(e.key==='Escape'&&panel.classList.contains('is-open')) close(); });
  if(location.hash==='#commander') setTimeout(open,600);
  window.mmOrder={open:open,close:close};
})();
  </script>
  <script>
(function(){
  var d=document, reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches, mob=function(){return innerWidth<900;};

  /* barre de progression de lecture */
  var pb=d.getElementById('progress'), tk=false;
  function prog(){ tk=false; var h=d.documentElement.scrollHeight-innerHeight; pb.style.transform='scaleX('+(h>0?Math.min(1,scrollY/h):0)+')'; }
  addEventListener('scroll',function(){ if(!tk){tk=true;requestAnimationFrame(prog);} },{passive:true}); prog();

  /* galerie du hero : défilement automatique + glisser du doigt */
  var thumbs=[].slice.call(d.querySelectorAll('.h-thumbs button')), stage=d.querySelector('.h-stage'), main=d.getElementById('hMain'), wrap=d.querySelector('.h-thumbs');
  if(thumbs.length>1 && stage){
    var DELAY=4000, timer=null, stopped=false;
    function cur(){ for(var i=0;i<thumbs.length;i++) if(thumbs[i].getAttribute('aria-current')==='true') return i; return 0; }
    function go(i,dir){
      i=(i+thumbs.length)%thumbs.length; thumbs[i].click();
      if(!reduce){ main.classList.remove('slide-l','slide-r'); void main.offsetWidth; main.classList.add(dir<0?'slide-r':'slide-l'); }
      restartBar();
    }
    function restartBar(){ if(!wrap.classList.contains('auto')) return; wrap.classList.remove('auto'); void wrap.offsetWidth; wrap.classList.add('auto'); }
    function play(){ if(reduce||stopped) return; clearInterval(timer); wrap.style.setProperty('--auto',DELAY+'ms'); wrap.classList.add('auto'); timer=setInterval(function(){ go(cur()+1,1); },DELAY); }
    function stop(){ stopped=true; clearInterval(timer); wrap.classList.remove('auto'); }
    thumbs.forEach(function(b){ b.addEventListener('pointerdown',stop); });
    var x0=null,y0=null;
    stage.addEventListener('touchstart',function(e){ x0=e.touches[0].clientX; y0=e.touches[0].clientY; },{passive:true});
    stage.addEventListener('touchend',function(e){
      if(x0===null) return; var dx=e.changedTouches[0].clientX-x0, dy=e.changedTouches[0].clientY-y0; x0=null;
      if(Math.abs(dx)>40 && Math.abs(dx)>Math.abs(dy)){ stop(); go(cur()+(dx<0?1:-1),dx<0?1:-1); }
    },{passive:true});
    if('IntersectionObserver' in window){
      new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting) play(); else clearInterval(timer); }); },{threshold:.4}).observe(stage);
    } else play();
  }

  /* carrousels mobiles : points + petit coup de pouce « glissez » */
  [].forEach.call(d.querySelectorAll('.benefits,.demo,.incl,.reviews'),function(row){
    var items=[].slice.call(row.children), nudging=false; if(items.length<2) return;
    var hint=d.createElement('div'); hint.className='swipe-hint'; hint.setAttribute('aria-hidden','true'); hint.innerHTML='Glissez pour voir la suite <i>→</i>';
    row.parentNode.insertBefore(hint,row);
    var dots=d.createElement('div'); dots.className='cdots';
    items.forEach(function(it,i){ var b=d.createElement('button'); b.type='button'; b.setAttribute('aria-label','Élément '+(i+1)); b.addEventListener('click',function(){ row.scrollTo({left:it.offsetLeft-row.offsetLeft-parseFloat(getComputedStyle(row).paddingLeft),behavior:'smooth'}); }); dots.appendChild(b); });
    row.parentNode.insertBefore(dots,row.nextSibling);
    function upd(){ var best=0,bd=1e9,l=row.scrollLeft; items.forEach(function(it,i){ var dd=Math.abs(it.offsetLeft-row.offsetLeft-parseFloat(getComputedStyle(row).paddingLeft)-l); if(dd<bd){bd=dd;best=i;} }); [].forEach.call(dots.children,function(b,i){ b.setAttribute('aria-current',i===best?'true':'false'); }); if(l>20 && !nudging) hint.style.opacity='0'; }
    row.addEventListener('scroll',function(){ requestAnimationFrame(upd); },{passive:true}); upd();
    if(!reduce && 'IntersectionObserver' in window){
      var io=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting && mob()){ io.disconnect(); setTimeout(function(){ nudging=true; row.scrollBy({left:70,behavior:'smooth'}); setTimeout(function(){ row.scrollBy({left:-70,behavior:'smooth'}); setTimeout(function(){ nudging=false; },600); },550); },400); } }); },{threshold:.6});
      io.observe(row);
    }
  });
})();
  </script>
  <script>
(function(){
  var g=document.getElementById('ageGate'); if(!g) return;
  var root=document.documentElement;
  if(!root.classList.contains('age-ok')) root.classList.add('age-lock');
  g.querySelector('[data-age-ok]').addEventListener('click',function(){
    try{ sessionStorage.setItem('ag18','1'); }catch(e){}
    root.classList.add('age-ok'); root.classList.remove('age-lock');
  });
})();
  </script>
  <script>
(function(){
  document.querySelectorAll('.vid').forEach(function(f){
    var v=f.querySelector('video'), held=false;
    function sync(){ f.classList.toggle('playing',!v.paused); }
    v.addEventListener('play',sync); v.addEventListener('pause',sync);
    function play(){ var p=v.play(); if(p&&p.catch) p.catch(function(){}); }
    f.addEventListener('click',function(){ if(v.paused){ held=false; play(); } else { held=true; v.pause(); } });
    if('IntersectionObserver' in window){
      new IntersectionObserver(function(es){ es.forEach(function(e){
        if(e.isIntersecting){ if(!held) play(); } else if(!v.paused){ v.pause(); }
      }); },{threshold:.45}).observe(f);
    }
  });
})();
  </script>
